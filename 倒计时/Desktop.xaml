<Page
    x:Class="倒计时.Desktop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:倒计时"
    xmlns:material="using:倒计时.Controls"
    xmlns:layout="using:倒计时.Controls"
    xmlns:local1="using:倒计时.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    Margin="0"
    mc:Ignorable="d">
    <Page.Resources>
        <SolidColorBrush x:FieldModifier="public" x:Name="TC" x:Key="ThemeColor"  Color="CornflowerBlue" />
        <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="ThemeColor" x:FieldModifier="public"/>
        <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="ThemeColor" />
        <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="ThemeColor"/>

    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="DesktopTopText"
                       Text="桌面显示"
                       Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Top" Style="{StaticResource AppPageTitleStyle}" Margin="24,24,24,16" TextWrapping="Wrap"/>
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" layout:CenteredScrollContent.IsEnabled="True">
            <Grid MaxWidth="640" Margin="24,16,24,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                    <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}" Grid.Row="1" Margin="0,0,0,20" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <StackPanel x:Name="ListBackgroundPanel" Orientation="Vertical" material:MaterialSurface.IsEnabled="True" Padding="24" CornerRadius="{ThemeResource AppCardCornerRadius}" BorderThickness="0" Spacing="0">
                            <TextBlock Text="日程列表" HorizontalAlignment="Left" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock x:Name="SelectedCountTextBlock" Text="最多选取三个日程 · 0/3" Margin="0,0,0,12" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                            <ListView x:Name="DesktopList"
                                      MaxHeight="280"
                                      MinHeight="56"
                                      ItemsSource="{x:Bind DesViewModel.DesktopDatas}"
                                      IsItemClickEnabled="True"
                                      SelectionMode="None"
                                      IsMultiSelectCheckBoxEnabled="False"
                                      SelectionChanged="DesktopList_SelectionChanged"
                                      Background="Transparent"
                                      ItemClick="DesktopList_ItemClick">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="ItemRoot"
                                                            CornerRadius="{ThemeResource AppControlCornerRadius}"
                                                            BorderThickness="1"
                                                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                            Background="Transparent"
                                                            Margin="0,0,0,8"
                                                            Padding="14,12"
                                                            MinHeight="48">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="PointerOver">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="ItemRoot.Background" Value="{ThemeResource SystemControlBackgroundListLowBrush}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Pressed">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="ItemRoot.Background" Value="{ThemeResource SystemControlBackgroundListMediumBrush}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Selected">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="ItemRoot.Background" Value="{ThemeResource SystemControlBackgroundListLowBrush}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="SelectedPointerOver">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="ItemRoot.Background" Value="{ThemeResource SystemControlBackgroundListMediumBrush}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="SelectedPressed">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="ItemRoot.Background" Value="{ThemeResource SystemControlBackgroundListMediumBrush}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Disabled"/>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local1:DesktopEvents">
                                        <TextBlock Text="{x:Bind EventName}" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Text="已选择列表" FontWeight="SemiBold" HorizontalAlignment="Left" FontSize="18" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

                            <ListView x:Name="DesktopList2"
                                      MaxHeight="200"
                                      MinHeight="56"
                                      ItemsSource="{x:Bind DesViewModel2.DesktopDatas}"
                                      IsItemClickEnabled="True"
                                      SelectionMode="Single"
                                      Background="Transparent"
                                      ItemClick="DesktopList2_ItemClick">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="ItemRoot"
                                                            CornerRadius="{ThemeResource AppControlCornerRadius}"
                                                            BorderThickness="1"
                                                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                            Background="Transparent"
                                                            Margin="0,0,0,8"
                                                            Padding="14,12"
                                                            MinHeight="48">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="PointerOver">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="ItemRoot.Background" Value="{ThemeResource SystemControlBackgroundListLowBrush}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Pressed">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="ItemRoot.Background" Value="{ThemeResource SystemControlBackgroundListMediumBrush}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Selected">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="ItemRoot.Background" Value="{ThemeResource SystemControlBackgroundListLowBrush}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="SelectedPointerOver">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="ItemRoot.Background" Value="{ThemeResource SystemControlBackgroundListMediumBrush}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="SelectedPressed">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="ItemRoot.Background" Value="{ThemeResource SystemControlBackgroundListMediumBrush}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Disabled"/>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local1:DesktopEvents">
                                        <TextBlock Text="{x:Bind EventName}" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Margin="0,8,0,16" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       Text="若在主页删除了已固定到桌面的日程，请先关闭原有小工具，再点「固定到桌面」重新创建。"
                                       TextWrapping="Wrap"/>

                            <Grid x:Name="ButtonStackPanel" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="TestButton1" Content="固定到桌面" Click="TestButton1_Click" Style="{StaticResource AppPrimaryButtonStyle}" HorizontalAlignment="Stretch" Grid.Column="0"/>
                                <Button x:Name="TestButton2" Content="重置选择" Click="TestButton2_Click" Style="{StaticResource AppSecondaryButtonStyle}" HorizontalAlignment="Stretch" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </controls:DropShadowPanel>


                    <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}" Grid.Row="2" Margin="0,0,0,24" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <StackPanel x:Name="SettingsPanel" Orientation="Vertical" material:MaterialSurface.IsEnabled="True" Padding="24" CornerRadius="{ThemeResource AppCardCornerRadius}" BorderThickness="0" Spacing="0">
                            <TextBlock Text="个性化设置" HorizontalAlignment="Left" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock x:Name="Header1" Text="左上角标题" Margin="0,0,0,6" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                            <StackPanel x:Name="SettingsStackPanel" Orientation="Vertical" Spacing="8">
                                <TextBox x:Name="CornerNameTextBox" IsReadOnly="True" Text="夏日" BorderThickness="1" CornerRadius="{ThemeResource AppControlCornerRadius}" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" HorizontalAlignment="Stretch" Padding="12,10"/>
                                <Button x:Name="EditCornerNameButton" Content="修改标题" Click="EditCornerNameButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="100" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="0,20,0,0" Spacing="12">
                                <ToggleSwitch x:Name="TransparentSwitch" Header="亚克力模糊背景" Toggled="TransparentSwitch_Toggled"/>
                                <TextBlock x:Name="TransparentTipText" Text="深色壁纸下若背景过暗，可关闭此选项" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                <ToggleSwitch x:Name="ColorfulSwitch" Header="彩色背景" IsOn="False" Toggled="ColorfulSwitch_Toggled"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="ColorfulButton" Content="颜色选项" IsEnabled="False" VerticalAlignment="Center" Click="ColorfulButton_Click" Style="{StaticResource AppSecondaryButtonStyle}"/>
                                    <Ellipse x:Name="ColorfulEllipse" Visibility="Collapsed" Height="24" Width="24" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="重新创建桌面小工具后生效" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ContentDialog x:Name="ColorfulDialog"
                                           Title="颜色选项"
                                           CornerRadius="{ThemeResource AppControlCornerRadius}">
                                <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <ColorPicker x:Name="ColorfulBcakgroundPicker"
                                                IsMoreButtonVisible="True"
                                                IsColorSliderVisible="True"
                                                IsColorChannelTextInputVisible="True"
                                                IsHexInputVisible="True"
                                                IsAlphaEnabled="False"
                                                IsAlphaSliderVisible="True"
                                                IsAlphaTextInputVisible="True" />
                                    <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ColorfulDialogPrimaryButton" Content="确认" Click="ColorfulDialogPrimaryButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/><Button x:Name="ColorfulDialogCloseButton" Content="取消" Click="ColorfulDialogCloseButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0" Padding="8"/></Grid>
                                </StackPanel>

                            </ContentDialog>
                        </StackPanel>
                    </controls:DropShadowPanel>



            </Grid>
        </ScrollViewer>


    </Grid>
</Page>
