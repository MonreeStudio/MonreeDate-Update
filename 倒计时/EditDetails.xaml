<Page
    x:Class="夏日.EditDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:夏日"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:control="using:倒计时.Controls"
    mc:Ignorable="d"
    Margin="0">

    <Page.Resources>
        <SolidColorBrush x:FieldModifier="public" x:Name="TC" x:Key="ThemeColor"  Color="CornflowerBlue"/>
        <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="ThemeColor" />
        <StaticResource x:Key="SliderThumbBackground" ResourceKey="ThemeColor" />

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="编辑日程"
                       x:Name="title"
                       Grid.Row="0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"  Style="{StaticResource AppPageTitleStyle}" Margin="24,24,24,16"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <StackPanel x:FieldModifier="Public" MaxWidth="560" Margin="24,0,24,32">
                <StackPanel>
                    <TextBlock Text="提示：若该日程已被固定到开始菜单，则更改信息后需重新固定。" TextWrapping="Wrap" Margin="20,5,20,16" FontSize="15" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="日程名称" Margin="20,0,0,10" FontSize="20" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBox x:Name="AddEvent"
                 CornerRadius="8"
                 BorderBrush="{x:Bind TC}"
                 VerticalAlignment="Bottom"
                 Height="Auto"
                 BorderThickness="1" HorizontalAlignment="Stretch" Margin="20,0,20,0"/>
                </StackPanel>
                <ComboBox x:Name="ScheduleTypePicker" Header="日程类型" SelectedIndex="0" Margin="20,24,0,0"
                          Width="200" CornerRadius="8" BorderBrush="{x:Bind TC}"
                          SelectionChanged="ScheduleTypePicker_SelectionChanged">
                    <ComboBoxItem Content="单日"/>
                    <ComboBoxItem Content="日期范围"/>
                </ComboBox>
                <StackPanel Margin="0,24,0,0">
                    <TextBlock x:Name="StartDateLabel" Text="日程日期" Margin="20,0,0,10" FontSize="20" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <CalendarDatePicker HorizontalAlignment="Left"
                            Margin="20,0,0,0"
                            x:Name="Add_Picker"
                            BorderThickness="1"
                            Foreground="{x:Bind TC}"
                            BorderBrush="{x:Bind TC}"
                            DateFormat="{}{year.full}/{month.integer}/{day.integer}"
                            CornerRadius="8"
                            PlaceholderText="选择一个日期"
                                    IsGroupLabelVisible="True"
                            DateChanged="Add_Picker_DateChanged"
                            >
                        <CalendarDatePicker.CalendarViewStyle>
                            <Style TargetType="CalendarView" BasedOn="{StaticResource CalendarViewRevealStyle}">
                                <Setter Property="CalendarViewDayItemStyle">
                                    <Setter.Value>
                                        <Style TargetType="CalendarViewDayItem">
                                            <Setter Property="Padding" Value="0, 0, 0, 18" />
                                            <Setter Property="MinWidth" Value="44" />
                                            <Setter Property="MinHeight" Value="48" />
                                            <Setter Property="Margin" Value="1" />
                                            <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                                            <Setter Property="FocusVisualMargin" Value="-2" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="CalendarViewDayItem">
                                                        <!-- For CalendarViewDayItem, TextBlock visual is created and handled by code and we can't see it from the style. -->
                                                        <!-- CCalendarViewBaseItemChrome creates and appends a TextBlock in the visual after the ControlTemplate is applied -->
                                                        <!-- VSM needs a container and that's why Grid is added. But we don't need the rendering of Grid so We set width to 0 -->
                                                        <Grid x:Name="Root">

                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal" />

                                                                    <VisualState x:Name="PointerOver">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="Root.(RevealBrush.State)" Value="PointerOver" />
                                                                        </VisualState.Setters>
                                                                    </VisualState>

                                                                    <VisualState x:Name="Pressed">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="Root.(RevealBrush.State)" Value="Pressed" />
                                                                        </VisualState.Setters>
                                                                    </VisualState>
                                                                </VisualStateGroup>

                                                            </VisualStateManager.VisualStateGroups>
                                                            <control:CalendarViewDayLunarItem Date="{TemplateBinding Date}" Foreground="DarkGray" Margin="0,0,0,-14" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </CalendarDatePicker.CalendarViewStyle>
                    </CalendarDatePicker>
                    <StackPanel x:Name="EndDatePanel" Visibility="Collapsed" Margin="20,20,20,0">
                        <TextBlock Text="结束日期" Margin="0,0,0,10" FontSize="20" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                        <CalendarDatePicker x:Name="End_Picker" HorizontalAlignment="Left" BorderThickness="1"
                                            Foreground="{x:Bind TC}" BorderBrush="{x:Bind TC}" CornerRadius="8"
                                            DateFormat="{}{year.full}/{month.integer}/{day.integer}"
                                            IsGroupLabelVisible="True" PlaceholderText="选择结束日期" DateChanged="Add_Picker_DateChanged"/>
                        <TextBlock Text="包含开始和结束当天；提醒以开始日期为准。" Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="DateValidationText" Visibility="Collapsed" Foreground="Crimson" Margin="20,8,20,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Margin="20,24,0,0" Orientation="Horizontal">
                    <Button Content="背景选项"
                    x:Name="BgsButton"
                    HorizontalAlignment="Left"
                    Click="BgsButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="100" Width="140"/>
                    <Ellipse x:Name="MyEllipse" Height="20" Width="20" Margin="10" Fill="Transparent" StrokeThickness="0"/>
                </StackPanel>
                <StackPanel Margin="20,24,0,0" Orientation="Horizontal">
                    <Button Content="备注"
                        x:Name="TipButton"
                        HorizontalAlignment="Left"
                        Click="TipButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="100" Width="140"/>
                    <TextBlock x:Name="TTB" Margin="10,0,0,0" FontSize="15" Foreground="Gray" TextWrapping="Wrap" VerticalAlignment="Top" MaxWidth="200"/>
                </StackPanel>
                <Button Content="确认修改"
                x:Name="UpdateButton"
                HorizontalAlignment="Left"
                Click="UpdateButton_Click" MinWidth="100" Style="{StaticResource AppPrimaryButtonStyle}" Margin="20,24,0,0" Width="140"/>
                <ContentDialog x:Name="BgsDialog"
                   Title="背景设置"
                   CornerRadius="{ThemeResource AppControlCornerRadius}">
                    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <TextBlock Text="建议选择较为温和的颜色" Margin="5,0,0,0" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <ColorPicker x:Name="MyColorPicker"
                             Margin="5"
                             IsColorSliderVisible="True"
                             IsMoreButtonVisible="True"
                             IsColorChannelTextInputVisible="True"
                             IsHexInputVisible="True"
                             IsAlphaEnabled="False"
                             IsAlphaSliderVisible="True"
                             IsAlphaTextInputVisible="True"
                             />
                        <Slider AutomationProperties.Name="Slider with ticks"
                        x:Name="MySlider"
                            Foreground="{x:Bind TC}"
                        Header="不透明度（推荐40~80，0为全透明）"
                        Margin="5"
                        Maximum="100"
                        TickFrequency="10"
                        TickPlacement="Outside" />
                        <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="BgsDialogPrimaryButton" Content="确认" Click="BgsDialogPrimaryButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/><Button x:Name="BgsDialogCloseButton" Content="取消" Click="BgsDialogCloseButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0" Padding="8"/></Grid>
                    </StackPanel>
                </ContentDialog>
                <ContentDialog x:Name="TipDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       Title="添加备注"
                       CornerRadius="{ThemeResource AppControlCornerRadius}"
                       >
                    <StackPanel>
                        <TextBox x:Name="TipTextbox" Margin="5" TextWrapping="Wrap" BorderThickness="2" PlaceholderText ="备注可留空" CornerRadius="8"/>
                        <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="TipDialogPrimaryButton" Content="确认" Click="TipDialogPrimaryButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/><Button x:Name="TipDialogCloseButton" Content="取消" Click="TipDialogCloseButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0" Padding="8"/></Grid>
                    </StackPanel>
                </ContentDialog>
            </StackPanel>
        </ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{x:Bind MinMyNav}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="title.Margin" Value="24,24,24,16"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
