    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="CalculatorTopText" Text="计算" Style="{StaticResource AppPageTitleStyle}" Margin="24,24,24,16"/>
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" layout:CenteredScrollContent.IsEnabled="True">
            <StackPanel x:Name="PageStackPanel" MaxWidth="640" Margin="24,16,24,32" Spacing="24">
                <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}">
                    <Grid x:Name="DistanceGrid" material:MaterialSurface.IsEnabled="True" BorderThickness="0" CornerRadius="{ThemeResource AppCardCornerRadius}" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="日期距离" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock x:Name="StartDate" Text="选择两个日期，计算相隔的天数。" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            <TextBlock x:Name="EndDate" Visibility="Collapsed" Foreground="{ThemeResource AppAccentBrush}"/>
                            <CalendarDatePicker CornerRadius="8" DateChanged="Picker1_DateChanged" x:Name="Picker1" BorderThickness="1" BorderBrush="{x:Bind TC}" VerticalAlignment="Center" IsGroupLabelVisible="True" DateFormat="{}{year.full}/{month.integer}/{day.integer}" MinWidth="0" HorizontalAlignment="Stretch" Header="开始日期" PlaceholderText="选择日期">
                                    <CalendarDatePicker.CalendarViewStyle>
                                        <Style TargetType="CalendarView" BasedOn="{StaticResource CalendarViewRevealStyle}">
                                            <Setter Property="CalendarViewDayItemStyle">
                                                <Setter.Value>
                                                    <Style TargetType="CalendarViewDayItem">
                                                        <Setter Property="Padding" Value="0, 0, 0, 18" />
                                                        <Setter Property="MinWidth" Value="44" />
                                                        <Setter Property="MinHeight" Value="48" />
                                                        <Setter Property="Margin" Value="1" />
                                                        <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                                                        <Setter Property="FocusVisualMargin" Value="-2" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="CalendarViewDayItem">
                                                                    <!-- For CalendarViewDayItem, TextBlock visual is created and handled by code and we can't see it from the style. -->
                                                                    <!-- CCalendarViewBaseItemChrome creates and appends a TextBlock in the visual after the ControlTemplate is applied -->
                                                                    <!-- VSM needs a container and that's why Grid is added. But we don't need the rendering of Grid so We set width to 0 -->
                                                                    <Grid x:Name="Root">

                                                                        <VisualStateManager.VisualStateGroups>
                                                                            <VisualStateGroup x:Name="CommonStates">
                                                                                <VisualState x:Name="Normal" />

                                                                                <VisualState x:Name="PointerOver">
                                                                                    <VisualState.Setters>
                                                                                        <Setter Target="Root.(RevealBrush.State)" Value="PointerOver" />
                                                                                    </VisualState.Setters>
                                                                                </VisualState>

                                                                                <VisualState x:Name="Pressed">
                                                                                    <VisualState.Setters>
                                                                                        <Setter Target="Root.(RevealBrush.State)" Value="Pressed" />
                                                                                    </VisualState.Setters>
                                                                                </VisualState>
                                                                            </VisualStateGroup>

                                                                        </VisualStateManager.VisualStateGroups>
                                                                        <control:CalendarViewDayLunarItem Date="{TemplateBinding Date}" Foreground="DarkGray" Margin="0,0,0,-14" />
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </CalendarDatePicker.CalendarViewStyle>
                                </CalendarDatePicker>
                            <CalendarDatePicker CornerRadius="8" DateChanged="Picker2_DateChanged" x:Name="Picker2" BorderThickness="1" BorderBrush="{x:Bind TC}" VerticalAlignment="Center" IsGroupLabelVisible="True" DateFormat="{}{year.full}/{month.integer}/{day.integer}" MinWidth="0" HorizontalAlignment="Stretch" Header="结束日期" PlaceholderText="选择日期">
                                    <CalendarDatePicker.CalendarViewStyle>
                                        <Style TargetType="CalendarView" BasedOn="{StaticResource CalendarViewRevealStyle}">
                                            <Setter Property="CalendarViewDayItemStyle">
                                                <Setter.Value>
                                                    <Style TargetType="CalendarViewDayItem">
                                                        <Setter Property="Padding" Value="0, 0, 0, 18" />
                                                        <Setter Property="MinWidth" Value="44" />
                                                        <Setter Property="MinHeight" Value="48" />
                                                        <Setter Property="Margin" Value="1" />
                                                        <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                                                        <Setter Property="FocusVisualMargin" Value="-2" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="CalendarViewDayItem">
                                                                    <!-- For CalendarViewDayItem, TextBlock visual is created and handled by code and we can't see it from the style. -->
                                                                    <!-- CCalendarViewBaseItemChrome creates and appends a TextBlock in the visual after the ControlTemplate is applied -->
                                                                    <!-- VSM needs a container and that's why Grid is added. But we don't need the rendering of Grid so We set width to 0 -->
                                                                    <Grid x:Name="Root">

                                                                        <VisualStateManager.VisualStateGroups>
                                                                            <VisualStateGroup x:Name="CommonStates">
                                                                                <VisualState x:Name="Normal" />

                                                                                <VisualState x:Name="PointerOver">
                                                                                    <VisualState.Setters>
                                                                                        <Setter Target="Root.(RevealBrush.State)" Value="PointerOver" />
                                                                                    </VisualState.Setters>
                                                                                </VisualState>

                                                                                <VisualState x:Name="Pressed">
                                                                                    <VisualState.Setters>
                                                                                        <Setter Target="Root.(RevealBrush.State)" Value="Pressed" />
                                                                                    </VisualState.Setters>
                                                                                </VisualState>
                                                                            </VisualStateGroup>

                                                                        </VisualStateManager.VisualStateGroups>
                                                                        <control:CalendarViewDayLunarItem Date="{TemplateBinding Date}" Foreground="DarkGray" Margin="0,0,0,-14" />
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </CalendarDatePicker.CalendarViewStyle>
                                </CalendarDatePicker>
                            <Button x:Name="CalButton" Content="计算" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="120" Click="Button_Click"/>
                            <TextBlock x:Name="SpanTime" FontSize="20" TextWrapping="Wrap" Foreground="{ThemeResource AppAccentBrush}"/>
                        </StackPanel>
                    </Grid>
                </controls:DropShadowPanel>
                <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}">
                    <Grid x:Name="ConverterGrid" material:MaterialSurface.IsEnabled="True" BorderThickness="0" CornerRadius="{ThemeResource AppCardCornerRadius}" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="农历转换" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                            <StackPanel x:Name="LunarChangeStackPanel" Spacing="16">
                                <CalendarView  x:Name="TermCalendarView" CornerRadius="8" Width="Auto" BorderThickness="1" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsGroupLabelVisible="True" SelectedDatesChanged="TermCalendarView_SelectedDatesChanged" HorizontalAlignment="Stretch">
                                            <CalendarView.Style>
                                                <Style TargetType="CalendarView" BasedOn="{StaticResource CalendarViewRevealStyle}">
                                                    <Setter Property="CalendarViewDayItemStyle">
                                                        <Setter.Value>
                                                            <Style TargetType="CalendarViewDayItem">
                                                                <Setter Property="Padding" Value="0, 0, 0, 18" />
                                                                <Setter Property="MinWidth" Value="44" />
                                                                <Setter Property="MinHeight" Value="48" />
                                                                <Setter Property="Margin" Value="1" />
                                                                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                                                                <Setter Property="FocusVisualMargin" Value="-2" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="CalendarViewDayItem">
                                                                            <!-- For CalendarViewDayItem, TextBlock visual is created and handled by code and we can't see it from the style. -->
                                                                            <!-- CCalendarViewBaseItemChrome creates and appends a TextBlock in the visual after the ControlTemplate is applied -->
                                                                            <!-- VSM needs a container and that's why Grid is added. But we don't need the rendering of Grid so We set width to 0 -->
                                                                            <Grid x:Name="Root">

                                                                                <VisualStateManager.VisualStateGroups>
                                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                                        <VisualState x:Name="Normal" />

                                                                                        <VisualState x:Name="PointerOver">
                                                                                            <VisualState.Setters>
                                                                                                <Setter Target="Root.(RevealBrush.State)" Value="PointerOver" />
                                                                                            </VisualState.Setters>
                                                                                        </VisualState>

                                                                                        <VisualState x:Name="Pressed">
                                                                                            <VisualState.Setters>
                                                                                                <Setter Target="Root.(RevealBrush.State)" Value="Pressed" />
                                                                                            </VisualState.Setters>
                                                                                        </VisualState>
                                                                                    </VisualStateGroup>

                                                                                </VisualStateManager.VisualStateGroups>
                                                                                <control:CalendarViewDayLunarItem Date="{TemplateBinding Date}" Foreground="DarkGray" Margin="0,0,0,-14" />
                                                                            </Grid>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </CalendarView.Style>
                                        </CalendarView>
                                <TextBlock x:Name="TermTextBlock" TextWrapping="Wrap" FontSize="16" Foreground="{ThemeResource AppAccentBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </controls:DropShadowPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
