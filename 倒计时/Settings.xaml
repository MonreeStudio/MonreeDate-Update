<Page
    x:Class="倒计时.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:倒计时"
    xmlns:material="using:倒计时.Controls"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:layout="using:倒计时.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:extensions="using:Microsoft.Toolkit.Uwp.UI.Extensions"
    xmlns:local1="using:倒计时.Models"
    DataContext="{Binding MainViewModel, Source={StaticResource Locator}}"
    mc:Ignorable="d"
    Margin="0">

    <Page.Resources>
        <SolidColorBrush x:FieldModifier="public" x:Name="TC" x:Key="ThemeColor"  Color="CornflowerBlue" />
        <LinearGradientBrush x:Key="ButtonLinearGradientBrush" StartPoint="0,0" EndPoint="1,1" Opacity="01">
            <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0.5" />
            <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TitleLinearGradientBrush" StartPoint="0,0" EndPoint="1,1" Opacity="01">
            <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0.3" />
            <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="1.0"/>
        </LinearGradientBrush>
        <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="ThemeColor" x:FieldModifier="public"/>
        <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="ThemeColor" />
        <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="ThemeColor"/>

    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SettingsTopText"
                       Text="个性化设置"
                       Grid.Row="0"
                       VerticalAlignment="Top" Style="{StaticResource AppPageTitleStyle}" Margin="24,24,24,16"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" layout:CenteredScrollContent.IsEnabled="True">
            <Grid MaxWidth="880" Margin="24,16,24,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
                    <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}">
                        <Grid Padding="20" CornerRadius="{ThemeResource AppCardCornerRadius}" material:MaterialSurface.IsEnabled="True" BorderThickness="0">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical" Grid.ColumnSpan="2">
                            <PersonPicture x:Name="MyPersonPicture"
                       ToolTipService.ToolTip="点击更换头像"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Grid.Column="0"
                       Tapped="MyPersonPicture_Tapped"
                       PointerEntered="MyPersonPicture_PointerEntered"
                       PointerExited="MyPersonPicture_PointerExited"
                        Width="72" Height="72"/>
                            <StackPanel Margin="0,16,0,0" Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NameTB" Text="昵称：" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="14"/>
                                    <TextBlock x:Name="PersonalNickName" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" x:FieldModifier="Public" Text="游客" FontSize="13"/>
                                </StackPanel>
                                <StackPanel x:Name="EmailStackPanel" Orientation="Horizontal" Visibility="Collapsed">
                                    <TextBlock x:Name="EmailTB" Text="邮箱：" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="14"/>
                                    <TextBlock x:Name="PersonalEmail" Foreground="{x:Bind TC}" x:FieldModifier="Public" Text="无" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SexTB" Text="性别：" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="14"/>
                                    <TextBlock x:Name="PersonalSex" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" x:FieldModifier="Public" Text="未选择" FontSize="13" />
                                </StackPanel>
                                <StackPanel x:Name="BirthCreate" Orientation="Horizontal" IsTapEnabled="True" Tapped="BirthCreate_Tapped" ToolTipService.ToolTip="点我看看？" PointerEntered="BirthCreate_PointerEntered" PointerExited="BirthCreate_PointerExited">
                                    <TextBlock x:Name="BirthdayTB" Text="生日："  Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="14"/>
                                    <TextBlock x:Name="PersonalBirthday" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" x:FieldModifier="Public" Text="未设置" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="SignTB" Text="个性签名：" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="14"/>
                                    <TextBlock x:Name="PersonalSign" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" x:FieldModifier="Public" Text="这个人好懒，什么也没写……" MaxWidth="200" HorizontalAlignment="Left" TextWrapping="WrapWholeWords" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="编辑个人信息"
                x:Name="EditButton"
                Click="Button_Click" Style="{StaticResource AppSecondaryButtonStyle}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                    </Grid>
                    </controls:DropShadowPanel>
                </Grid>
                <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,24">
                    <StackPanel Padding="20" Spacing="12" CornerRadius="{ThemeResource AppCardCornerRadius}" material:MaterialSurface.IsEnabled="True" BorderThickness="0">
                    <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="LoginButton" x:FieldModifier="Public" Visibility="Collapsed" Content="登录"   Click="LoginButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/><Button x:Name="SignOutButton" x:FieldModifier="Public" Visibility="Collapsed" Content="退出登录"   Click="SignOutButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0" Padding="8"/><Button x:Name="SyncButton" x:FieldModifier="Public" Visibility="Collapsed" Content="同步" Click="SyncButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="2" Margin="0" Padding="8"/></Grid>
                    <ToggleSwitch AutomationProperties.Name="simple ToggleSwitch"
                      Header="首页背景亚克力模糊效果"
                      HorizontalAlignment="Left"
                      x:Name="AllPageAcylic"
                      x:FieldModifier="public"
                              Visibility="Collapsed"
                      OnContent="开"
                      OffContent="关"
                      Toggled="AllPageAcylic_Toggled"/>
                    <ToggleSwitch x:Name="AllPersonPicture"
                      Header="首页显示头像"
                      Margin="0,5,0,0"
                      HorizontalAlignment="Left"
                      OnContent="开"
                      OffContent="关"
                      Toggled="AllPersonPicture_Toggled"/>
                    <ToggleSwitch x:Name="LunarSwitch"
                              Header="日程详情页显示阴历"
                              Margin="0,5,0,0"
                              HorizontalAlignment="Left"
                              OnContent="开"
                              OffContent="关"
                              Toggled="LunarSwitch_Toggled"/>
                    <ToggleSwitch x:Name="TileTip"
                              Header="磁贴显示日程备注"
                              Margin="0,5,0,0"
                              HorizontalAlignment="Left"
                              OnContent="开"
                              OffContent="关"
                              Toggled="TileTip_Toggled"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <ToggleSwitch x:Name="AutoStartSwitch"
                              Header="开机自启动"
                              HorizontalAlignment="Left"
                              OnContent="开"
                              OffContent="关"
                                  Visibility="Collapsed"
                              Toggled="AutoStartSwitch_Toggled"/>
                        <Button x:Name="AutoStartTipButton"
                            Content="&#xE82F;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Width="33"
                            Height="33"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed" Style="{StaticResource AppIconButtonStyle}">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedLeft">
                                    <TextBlock Text="自启动已被用户手动关闭，无法自动打开。&#x0a;请转至“设置”→“应用”→“启动”手动打开。" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <ToggleSwitch x:Name="ToolAutoStartSwitch"
                              Header="桌面小工具随应用启动"
                              Margin="0,5,0,0"
                              HorizontalAlignment="Left"
                              OnContent="开"
                              OffContent="关"
                              ToolTipService.ToolTip="已选择日程不为空时有效"
                              Toggled="ToolAutoStartSwitch_Toggled"/>
                    <TextBlock x:Name="AppAutoStartTip"
                           Visibility="Visible"
                           TextDecorations="Underline"
                           Text="设置应用开机自启动"
                           extensions:Mouse.Cursor="Hand"
                           Foreground="{x:Bind TC}"
                           Margin="0,15,0,20"
                           Tapped="AppAutoStartTip_Tapped"/>
                </StackPanel>
                </controls:DropShadowPanel>
                <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,24">
                    <StackPanel Padding="20" Spacing="8" CornerRadius="{ThemeResource AppCardCornerRadius}" material:MaterialSurface.IsEnabled="True" BorderThickness="0">
                    <ComboBox x:Name="MaterialStyleSelected" Header="应用材质"
                              HorizontalAlignment="Stretch" Margin="0,0,0,12"
                              SelectionChanged="MaterialStyleSelected_SelectionChanged">
                        <ComboBoxItem Content="Acrylic 亚克力" Tag="Acrylic"/>
                        <ComboBoxItem Content="Mica 云母" Tag="Mica"/>
                    </ComboBox>
                    <TextBlock Text="主题色" Margin="0,0,0,5" Foreground="{x:Bind ToolAutoStartSwitch.Foreground}"/>
                    <ComboBox x:Name="ThemeColorSelected" CornerRadius="8" BorderBrush="{x:Bind TC}" ItemsSource="{x:Bind ViewModel.ThemeColorDatas}" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ThemeColorData">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Fill="{x:Bind themeColor}" Height="25" Width="25" Margin="0,0,20,0"/>
                                    <TextBlock Text="{x:Bind colorName}" Margin="2" Foreground="{x:Bind themeColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                </controls:DropShadowPanel>
                <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,24">
                    <StackPanel Padding="20" CornerRadius="{ThemeResource AppCardCornerRadius}" material:MaterialSurface.IsEnabled="True" BorderThickness="0">
                    <Button x:Name="PinButton" Margin="0,0,0,20" Content="固定到开始菜单" ToolTipService.ToolTip="建议打开动态磁贴" Click="PinButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="160"/>
                    <Button x:Name="PinTaskbarButton" Margin="0,0,0,20" Content="固定到任务栏" Click="PinTaskbarButton_Click"   Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="160"/>
                    <Button x:Name="SupportButton" Margin="0,0,0,20" Content="支持开发者❤" Click="SupportButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="160">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="10">
                                        <Image Stretch="UniformToFill" Height="200" Width="150" Source="/Assets//支付宝收款码.jpg"/>
                                        <TextBlock Text="或" VerticalAlignment="Center" Margin="10" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                        <Image Stretch="UniformToFill" Height="200" Width="150" Source="/Assets//支付宝收款码2.jpg"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="10">
                                        <Image Stretch="UniformToFill" Height="200" Width="150" Source="/Assets//微信收款码.png"/>
                                        <TextBlock Text="或" VerticalAlignment="Center" Margin="10" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                        <Image Stretch="UniformToFill" Height="200" Width="150" Source="/Assets//微信收款码2.png"/>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button x:Name="CheckUpdate" Margin="0,0,10,0" Content="检查更新" Click="CheckUpdate_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="160"/>
                        <ProgressRing x:Name="UpdateRing" Foreground="{x:Bind TC}" IsActive="False"/>
                    </StackPanel>
                    <!--<ProgressBar x:Name="downloadProgressBar" Visibility="Collapsed" Width="200"/>-->
                </StackPanel>
                </controls:DropShadowPanel>
                <TextBlock x:Name="TestTb"
                   Grid.Row="3"
                   Grid.Column="0"
                   HorizontalAlignment="Center" Foreground="{ThemeResource AppAccentBrush}"/>
                <ContentDialog x:Name="SyncDataDialog"
                       DefaultButton="Primary"
                       CornerRadius="{ThemeResource AppControlCornerRadius}"
                       material:MaterialSurface.IsEnabled="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="将日程数据与云端同步" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,100,30" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TitleLinearGradientBrush}"/>
                        <StackPanel Grid.Row="1" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="GetLocalDataButton" Content="查看本地数据" Margin="5" Click="GetLocalDataButton_Click" HorizontalAlignment="Left" Style="{StaticResource AppSecondaryButtonStyle}"/>
                                <FontIcon x:Name="GetLocalDataIcon" Foreground="{StaticResource TitleLinearGradientBrush}" Visibility="Collapsed" Margin="10,0,0,0" Glyph="&#xE761;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="GetCloudDataButton" Content="查看云端数据" Margin="5" Click="GetCloudDataButton_Click" HorizontalAlignment="Left" Style="{StaticResource AppSecondaryButtonStyle}"/>
                                <FontIcon x:Name="GetCloudDataIcon" Foreground="{StaticResource TitleLinearGradientBrush}" Visibility="Collapsed" Margin="10,0,0,0"  Glyph="&#xE761;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource TitleLinearGradientBrush}" BorderThickness="1" CornerRadius="12">
                            <ListView x:Name="ToDoTaskList" Height="200" ItemsSource="{x:Bind TaskViewModel.ToDoDatas}" IsItemClickEnabled="True" SelectionMode="None" IsMultiSelectCheckBoxEnabled="False"  Background="Transparent" ItemClick="ToDoTaskList_ItemClick" RightTapped="ToDoTaskList_RightTapped">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="CornerRadius" Value="10"/>
                                        <Setter Property="BorderBrush" Value="LightGray"/>
                                        <Setter Property="BorderThickness" Value="0.3"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local1:ToDoTasks">
                                        <StackPanel>
                                            <TextBlock Margin="20,0,0,0" Text="{x:Bind Name}" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="StepFlyout" Text="哈哈哈哈" Foreground="{ThemeResource AppAccentBrush}"/>
                                    </MenuFlyout>
                                </ListView.ContextFlyout>
                            </ListView>
                        </StackPanel>
                        <ProgressRing x:Name="LoadProgressBar" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource ButtonLinearGradientBrush}"/>
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock Text="选择同步逻辑：" Margin="0,0,0,5" Foreground="{StaticResource ButtonLinearGradientBrush}"/>
                            <SplitButton x:Name="SyncWaySplitButton" CornerRadius="8" BorderThickness="1" Foreground="White" Background="{ThemeResource AppAccentBrush}" Click="SyncWaySplitButton_Click">
                                合并两端数据
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem x:Name="SyncWayItem1" Text="合并两端数据" Click="SyncWayItem1_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                        <MenuFlyoutItem x:Name="SyncWayItem2" Text="同步云端数据到本地" Click="SyncWayItem2_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                        <MenuFlyoutItem x:Name="SyncWayItem3" Text="同步本地数据到云端" Click="SyncWayItem3_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,20,0,0">

                            <StackPanel x:Name="SyncingStackPanel" Visibility="Collapsed" Margin="0,10,0,10" HorizontalAlignment="Left">
                                <TextBlock Text="同步中，请勿关闭应用" Foreground="{StaticResource TitleLinearGradientBrush}"/>
                                <ProgressBar IsIndeterminate="True" Foreground="{StaticResource TitleLinearGradientBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="SyncTimeTextBlock" Text="上次同步时间：未进行过同步操作。" Margin="0,20,0,15" Foreground="{StaticResource TitleLinearGradientBrush}"/>

                        </StackPanel>
                        <Button x:Name="ExitSyncButton" Grid.Row="4" Grid.ColumnSpan="2" Content="退出" HorizontalAlignment="Center" FontSize="15" Click="ExitSyncButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="100"/>

                    </Grid>

                </ContentDialog>
                <ContentDialog x:Name="AboutContent"
                       Title="关于“夏日”"
                       DefaultButton="Primary"
                       CornerRadius="{ThemeResource AppControlCornerRadius}">
                    <ScrollViewer>
                        <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBlock Foreground="Gray" x:Name="Version" Margin="10,10,0,5" />
                            <TextBlock Foreground="Gray" x:Name="SystemVersion" Margin="10,0,0,5" />
                            <TextBlock Foreground="Gray" x:Name="Platform" Margin="10,0,0,10"/>
                            <TextBlock Foreground="Gray" Text="一款简约设计的纪念日/倒计时记录应用。"
            TextWrapping="Wrap" Margin="10"/>
                            <Image Source="Assets/03.png" Width="350" Height="350"/>
                            <TextBlock Foreground="Gray" Text="梦睿工作室(Monree Studio)——Bill夏昕" Margin="10"/>
                            <TextBlock  Foreground="Gray" Text="开发者邮箱：monreestudio@outlook.com" Margin="10" />
                            <HyperlinkButton Content="Github开源项目"
                                 Margin="10"
                                         Visibility="Collapsed"
                                 NavigateUri="https://github.com/MonreeStudio/MonreeDate-Update"/>
                            <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="AboutDialogPrimaryButton" Content="了解" Click="AboutDialogPrimaryButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/><Button x:Name="AboutDialogSecondryButton" Content="五星好评😝" Click="AboutDialogSecondryButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0" Padding="8"/><Button x:Name="AboutDialogCloseButton" Content="不了解" Click="AboutDialogCloseButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="2" Margin="0" Padding="8"/></Grid>
                        </StackPanel>
                    </ScrollViewer>
                </ContentDialog>
                <ContentDialog x:Name="BirthDialog"
                       Title="添加出生日为日程"
                       CornerRadius="{ThemeResource AppControlCornerRadius}">
                    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="BirthText" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock Text="添加后将被固定为日程到首页，显示你出生至今已过的日子。&#x0a;这或许是一件有趣的事情~"
                                TextWrapping="Wrap"  Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="BirthDialogPrimaryButton" Content="确认" Click="BirthDialogPrimaryButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/><Button x:Name="BirthDialogCloseButton" Content="取消" Click="BirthDialogCloseButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0" Padding="8"/></Grid>
                    </StackPanel>
                </ContentDialog>
                <ContentDialog x:Name="AutoStartTipDialog"
                           Title="设置应用开机自启动"
                       CornerRadius="{ThemeResource AppControlCornerRadius}">
                    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <TextBlock TextWrapping="WrapWholeWords" Foreground="Gray" Width="400">
                        夏日暂不支持一键设置应用开机自启动，但可以通过您手动设置实现。只需以下简单几步：
                        </TextBlock>
                        <TextBlock Text="1、右击屏幕左下角的开始按钮，选择 运行；&#x0a;2、在 运行 内输入shell:startup，此时会打开一个文件夹窗口；&#x0a;3、打开开始菜单，在左侧的列表中找到夏日；&#x0a;4、将夏日拖拽到刚刚打开的文件夹窗口；"
                               Foreground="Gray"
                               Margin="10"/>
                        <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="AutoStartTipDialogPrimaryButton" Content="学会了！" Click="AutoStartTipDialogPrimaryButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/></Grid>
                    </StackPanel>
                </ContentDialog>
                <ContentDialog x:Name="CropperDialog"
                           Title="编辑头像"
                           CornerRadius="{ThemeResource AppControlCornerRadius}">
                    <StackPanel Spacing="20" MaxWidth="360">
                        <Grid HorizontalAlignment="Center">
                            <PersonPicture x:Name="EditPicture" Width="150" Height="150" Visibility="Collapsed" ProfilePicture="{Binding CroppedCircularImage}"/>
                            <PersonPicture x:Name="TempPicture" Width="150" Height="150" Visibility="Visible"/>
                        </Grid>
                        <Button x:Name="PickImgButton" HorizontalAlignment="Center"
                                Click="PickImgButton_Click" Command="{Binding CropCircularImageCommand}"
                                Content="选取图片" Style="{StaticResource AppSecondaryButtonStyle}"/>
                        <Grid Margin="0,4,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="CropperDialogPrimaryButton" Content="确认" Click="CropperDialogPrimaryButton_Click"
                                    Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch"/>
                            <Button x:Name="CropperDialogCloseButton" Content="取消" Click="CropperDialogCloseButton_Click" Grid.Column="1"
                                    Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </ContentDialog>
                <Button x:Name="AboutButton"
                Content="关于应用"
                Grid.Row="5"
                Click="AboutButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="100" Grid.Column="0" Margin="0" HorizontalAlignment="Left"/>

                <Frame x:Name="ContentFrame" x:FieldModifier="Public"/>
            </Grid>

        </ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger
                        MinWindowWidth="{x:Bind MinMyNav}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsTopText.Margin" Value="24,24,24,16"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</Page>
