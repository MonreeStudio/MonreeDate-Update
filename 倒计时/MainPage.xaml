<Page
    x:Class="倒计时.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:倒计时"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:倒计时.Models" xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    x:FieldModifier="Public"
    x:Name="MPage">

    <Page.Resources>
        <SolidColorBrush x:FieldModifier="public" x:Name="TC" x:Key="ThemeColor"  Color="CornflowerBlue"/>
    </Page.Resources>

    <!-- WinUI Gallery layout: title-bar row, then NavigationView. -->
    <Grid x:Name="RootLayout" SizeChanged="RootLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarSpacer" Grid.Row="0" Background="Transparent"/>

        <Grid Grid.Row="1">
            <muxc:NavigationView x:Name="MyNav"
                        Loaded="MyNav_Loaded"
                        ItemInvoked="MyNav_ItemInvoked"
                        BackRequested="MyNav_BackRequested"
                        SelectionChanged="MyNav_SelectionChanged"
                        DisplayModeChanged="MyNav_DisplayModeChanged"
                        PaneDisplayMode="Auto"
                        PaneTitle="夏日 —— 记录你的生活"
                        IsTitleBarAutoPaddingEnabled="False"
                        Margin="0,0,0,0"
                        x:FieldModifier="public">
                <muxc:NavigationView.MenuItems>
                    <muxc:NavigationViewItem x:Name="AllItem" x:FieldModifier="public" SelectsOnInvoked="True" Tag="All" Icon="Home" Content="日子"/>
                    <muxc:NavigationViewItem x:Name="ToDoItem" Visibility="Visible" x:FieldModifier="public" Tag="ToDo" Icon="AllApps" Content="计划"/>
                    <muxc:NavigationViewItem x:Name="NewItem" Visibility="Collapsed" x:FieldModifier="public" Tag="New" Icon="Add" Content="新建"/>
                    <muxc:NavigationViewItemHeader Content="工具"/>
                    <muxc:NavigationViewItem x:Name="CalculatorItem" x:FieldModifier="public" Tag="Calculator" Icon="Calculator" Content="计算"/>
                    <muxc:NavigationViewItem x:Name="FestivalItem" x:FieldModifier="public" Tag="Festival" Icon="CalendarDay" Content="节日"/>
                    <muxc:NavigationViewItem x:Name="DesktopItem" x:FieldModifier="public" Icon="GoToStart" Tag="Desktop" Content="桌面"/>
                    <muxc:NavigationViewItem x:Name="TimerItem" Visibility="Collapsed" x:FieldModifier="public" Icon="Clock" Tag="Timer" Content="计时"/>
                </muxc:NavigationView.MenuItems>
                <muxc:NavigationView.PaneFooter>
                    <muxc:NavigationViewItem Margin="0,0,-4,0" x:Name="FeedbackItem" x:FieldModifier="public" Icon="MailReply" Tag="Feedback" Content="反馈" IsTapEnabled="True" Tapped="FeedbackItem_Tapped"/>
                </muxc:NavigationView.PaneFooter>
                <Frame x:Name="ContentFrame"
                       Margin="0,0,0,0"
                       NavigationFailed="ContentFrame_NavigationFailed"
                       x:FieldModifier="Public" Navigated="ContentFrame_Navigated"/>
            </muxc:NavigationView>
            <ContentDialog x:Name="MyCD"
                       CornerRadius="{ThemeResource AppControlCornerRadius}"
                       Title="欢迎使用新版本的夏日~"
                       Background="{ThemeResource AppCardBackgroundBrush}">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock x:Name="Version" Foreground="{x:Bind TC}"/>
                        <TextBlock x:Name="WelcomeVersionInfo" TextWrapping="WrapWholeWords" Margin="0,0,0,5" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="&#x0a;感谢大家选择了夏日！若在使用过程中发现意外情况，请发送截图+文字描述到邮箱反馈。独自一人开发不易，您的好评将会是一份认可。若感觉此应用不错，还可以推荐给身边的朋友哦。感谢大家支持！&#x0a;&#x0a;——Bill夏昕" TextWrapping="WrapWholeWords" Foreground="SlateGray" Margin="10"/>
                        <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="MyCDPrimaryButton" Content="确定" Click="MyCDPrimaryButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/><Button x:Name="MyCDSecondaryButton" Content="好评鼓励！" Click="MyCDSecondaryButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0" Padding="8"/></Grid>
                    </StackPanel>
                </ScrollViewer>
            </ContentDialog>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="{x:Bind MyNav.CompactModeThresholdWidth}" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="MyNav.PaneDisplayMode" Value="LeftCompact"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1000"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="MyNav.PaneDisplayMode" Value="Left"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </Grid>
</Page>
