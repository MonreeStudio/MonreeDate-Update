<Page
    x:Class="倒计时.Details"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:倒计时"
    xmlns:material="using:倒计时.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:extensions="using:Microsoft.Toolkit.Uwp.UI.Extensions"
    Margin="0"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:FieldModifier="public" x:Name="TC" x:Key="ThemeColor"  Color="CornflowerBlue"/>
        <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="ThemeColor" />
        <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="ThemeColor"/>
        <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="ThemeColor" x:FieldModifier="public"/>
    </Page.Resources>

    <Grid x:Name="DetailsGrid" SizeChanged="DetailsGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Date and compact actions -->
        <Grid x:Name="DetailChrome" Grid.Row="0" Margin="48,16,48,0" MaxWidth="1040" HorizontalAlignment="Center">
            <TextBlock x:Name="HeaderDate" Text=""
                       VerticalAlignment="Center"
                       FontSize="13"
                       Opacity="0.75"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <CommandBar x:Name="DetailsCommandBar"
                        Background="Transparent"
                        IsOpen="False"
                        DefaultLabelPosition="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <AppBarButton Visibility="Collapsed" x:Name="ToastTestButton" Icon="Send" Label="通知测试" Click="ToastTestButton_Click"/>
                <AppBarButton x:Name="AlertButton" Label="提醒" ToolTipService.ToolTip="设置提醒" Click="AlertButton_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE823;" FontSize="16"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ShareButton" Label="分享" ToolTipService.ToolTip="分享日程" Click="ShareButton_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE72D;" FontSize="16"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="EditButton" Label="编辑" ToolTipService.ToolTip="编辑日程" Click="EditButton_Click">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE104;" FontSize="16"/>
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <ScrollViewer x:Name="DetailScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" SizeChanged="DetailScrollViewer_SizeChanged"
                      material:CenteredScrollContent.IsEnabled="True">
            <StackPanel x:Name="DetailContent" MaxWidth="1040" Margin="48,12,48,40">
                <Border x:Name="DetailTopDivider" Height="2" Background="White" Opacity="0.35"/>
                <Grid x:Name="HeroLayout" Margin="0,96,0,0" MinHeight="300">
                    <Grid.RowDefinitions><RowDefinition x:Name="HeroInfoRow" Height="Auto"/><RowDefinition x:Name="HeroCountdownRow" Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeroTextColumn" Width="3*"/>
                        <ColumnDefinition x:Name="HeroCountColumn" Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="HeroInfo" VerticalAlignment="Center" Margin="0,0,32,0" Spacing="12">
                        <Border x:Name="StatusChip" HorizontalAlignment="Left">
                            <TextBlock x:Name="StatusChipText" FontSize="12"/>
                        </Border>
                        <TextBlock x:Name="DetailsEvent" x:FieldModifier="public" FontSize="48"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock x:Name="DetailsPickedDate" x:FieldModifier="public" FontSize="18"
                                   TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock x:Name="LunarDate" x:FieldModifier="public" FontSize="16" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock x:Name="DurationText" Visibility="Collapsed" FontSize="13"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                    <Border x:Name="HeroDivider" Grid.Column="1" Width="2" HorizontalAlignment="Left"
                            Background="White" Opacity="0.35"/>
                    <StackPanel x:Name="CountdownPanel" Grid.Column="1" VerticalAlignment="Center" Margin="32,0,0,0" Spacing="12">
                        <TextBlock x:Name="CountdownPrefix" FontSize="14" TextAlignment="Center"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="200" HorizontalAlignment="Center">
                            <TextBlock x:Name="DetailsDate" x:FieldModifier="public" FontSize="168" FontWeight="Light"
                                       IsTapEnabled="True" Tapped="DetailsDate_Tapped"
                                       ToolTipService.ToolTip="点击切换显示模式（天数/周数/年数）"/>
                        </Viewbox>
                        <TextBlock x:Name="CountdownUnit" FontSize="18" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Range dates and progress share the page surface. -->
                <controls:DropShadowPanel x:Name="ProgressCard" Visibility="Collapsed"
                                          Style="{StaticResource AppCardShadowStyle}"
                                          Margin="0,0,0,32">
                    <Border x:Name="ProgressCardBorder" CornerRadius="12" Padding="20,16"
                            Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderThickness="0"
                            material:MaterialSurface.SubtleShadow="True"
                            material:MaterialSurface.IsEnabled="True">
                    <Grid>
                        <Border x:Name="ProgressCardTint" CornerRadius="8" IsHitTestVisible="False"/>
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="RangeStartLabel" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            <TextBlock x:Name="RangeEndLabel" Grid.Column="1" FontSize="13" TextAlignment="Right" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </Grid>
                        <Grid x:Name="RangeProgressHost" Height="16" SizeChanged="RangeProgressHost_SizeChanged">
                            <Border x:Name="RangeProgressTrack" Height="3" VerticalAlignment="Center" CornerRadius="1.5"
                                    Background="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
                            <Border x:Name="RangeProgressFill" Height="3" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="1.5" Width="0"/>
                            <Ellipse x:Name="RangeProgressThumb" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="RangeTodayLabel" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                    </Grid>
                    </Border>
                </controls:DropShadowPanel>

                <StackPanel x:Name="NotesSection" Spacing="24">
                    <Border x:Name="NotesDivider" Height="2" Background="White" Opacity="0.35"/>
                    <Grid>
                        <TextBlock x:Name="NotesTitle" Text="日程备注" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </Grid>
                    <StackPanel x:Name="TipCard" Visibility="Collapsed">
                        <TextBlock x:Name="TipText" FontSize="20" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ContentDialog Title="分享日程"
                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                   DefaultButton="Primary"
                       CornerRadius="{ThemeResource AppControlCornerRadius}"
                      Background="{ThemeResource SystemAltHighColor}"
                   x:Name="RenderDialog">
            <StackPanel Margin="10" >
                <Border x:Name="RenderBorder" x:FieldModifier="public">
                    <Grid x:Name="RenderGrid" Padding="25,10,30,10"  Height="Auto" Width="Auto" Background="{ThemeResource AppCardBackgroundBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RenderTitle" Text="——夏日——" HorizontalAlignment="Center" Grid.Row="1" Grid.ColumnSpan="2" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" FontSize="15" Margin="0,0,0,5"/>
                        <PersonPicture x:Name="RenderPicture" HorizontalAlignment="Left" Grid.Row="0" Width="115" Height="115" Margin="0,10,15,10" VerticalAlignment="Center"/>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="dEvent" Grid.Row="0" FontSize="25" Margin="0,5,0,0" Foreground="SlateGray" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="dCalDate" Grid.Row="1" FontSize="30" Margin="0,0,10,0" Foreground="SlateGray" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <TextBlock x:Name="dDate" Grid.Row="2" FontSize="18" Margin="0,0,0,10" Foreground="SlateGray" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="选取背景色：" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Rectangle x:Name="BlueRec" Width="40" Height="40" Margin="0,0,15,0" ToolTipService.ToolTip="蓝" IsTapEnabled="True" extensions:Mouse.Cursor="Hand" Tapped="BlueRec_Tapped"/>
                    <Rectangle x:Name="YellowRec" Width="40" Height="40" Margin="0,0,15,0" ToolTipService.ToolTip="黄" IsTapEnabled="True" extensions:Mouse.Cursor="Hand" Tapped="YellowRec_Tapped"/>
                    <Rectangle x:Name="GreenRec" Width="40" Height="40" Margin="0,0,15,0" ToolTipService.ToolTip="绿" IsTapEnabled="True" extensions:Mouse.Cursor="Hand" Tapped="GreenRec_Tapped"/>
                    <Rectangle x:Name="PinkRec" Width="40" Height="40" ToolTipService.ToolTip="粉" IsTapEnabled="True" extensions:Mouse.Cursor="Hand" Tapped="PinkRec_Tapped"/>
                </StackPanel>
                <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Share" Content="分享" Click="Share_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/><Button x:Name="Save" Content="保存" Click="Save_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0" Padding="8"/><Button x:Name="Cancel" Content="取消" Click="Cancel_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="2" Margin="0" Padding="8"/></Grid>
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="AlertContentDialog"
                       Title="设置提醒"
                       CornerRadius="12"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       MaxWidth="560"
                       CloseButtonText="关闭">
            <StackPanel Spacing="10" Margin="0,8,0,12">
                <TextBlock x:Name="RangeReminderHint"
                           Text="范围日程的提醒以开始日期为准。"
                           Visibility="Collapsed"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           Margin="0,0,0,2"/>

                <Grid Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1"
                      CornerRadius="10" Padding="16,10" MinHeight="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="当天" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock Text="日程当天提醒" FontSize="12"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="AlertToggleSwitch" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  Toggled="AlertToggleSwitch_Toggled"/>
                </Grid>

                <Grid Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1"
                      CornerRadius="10" Padding="16,10" MinHeight="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="提前一天" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock Text="提前 1 天提醒" FontSize="12"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="AlertToggleSwitch2" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  Toggled="AlertToggleSwitch2_Toggled"/>
                </Grid>

                <Grid Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1"
                      CornerRadius="10" Padding="16,10" MinHeight="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="提前三天" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock Text="提前 3 天提醒" FontSize="12"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="AlertToggleSwitch3" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  Toggled="AlertToggleSwitch3_Toggled"/>
                </Grid>

                <Grid Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1"
                      CornerRadius="10" Padding="16,10" MinHeight="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="自定义提前" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="提前" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            <ComboBox x:Name="DayComboBox"
                                      MinWidth="64"
                                      CornerRadius="8"
                                      BorderThickness="1"
                                      FontSize="13"
                                      TextSubmitted="DayComboBox_TextSubmitted"
                                      SelectionChanged="DayComboBox_SelectionChanged">
                                <x:String>2</x:String>
                                <x:String>4</x:String>
                                <x:String>5</x:String>
                                <x:String>6</x:String>
                                <x:String>7</x:String>
                                <x:String>8</x:String>
                                <x:String>9</x:String>
                                <x:String>10</x:String>
                                <x:String>11</x:String>
                                <x:String>12</x:String>
                                <x:String>13</x:String>
                                <x:String>14</x:String>
                                <x:String>15</x:String>
                                <x:String>16</x:String>
                                <x:String>17</x:String>
                                <x:String>18</x:String>
                                <x:String>19</x:String>
                                <x:String>20</x:String>
                                <x:String>21</x:String>
                                <x:String>22</x:String>
                                <x:String>23</x:String>
                                <x:String>24</x:String>
                                <x:String>25</x:String>
                                <x:String>26</x:String>
                                <x:String>27</x:String>
                                <x:String>28</x:String>
                                <x:String>29</x:String>
                                <x:String>30</x:String>
                            </ComboBox>
                            <TextBlock Text="天" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <ToggleSwitch x:Name="AlertToggleSwitch4" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  OnContent="" OffContent=""
                                  Toggled="AlertToggleSwitch4_Toggled"/>
                </Grid>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
