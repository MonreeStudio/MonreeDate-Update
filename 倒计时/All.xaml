<Page
    x:Class="倒计时.All"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:倒计时"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:animations="using:Microsoft.Toolkit.Uwp.UI.Animations"
    mc:Ignorable="d"
    x:Name="APage"
    x:FieldModifier="Public"
    xmlns:material="using:倒计时.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"

    Margin="0"
    >

    <Page.Resources>
        <SolidColorBrush x:FieldModifier="public" x:Name="TC" x:Key="ThemeColor"  Color="CornflowerBlue"/>
        <Style x:Key="ThumbStyle1" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ThumbBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid x:Name="RootGrid">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="BackgroundPointerOver"/>
                                            <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="Background"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="BackgroundPressed"/>
                                            <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="Background"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Rectangle RadiusY="28" RadiusX="28" Fill="{ThemeResource SystemChromeMediumColor}" Opacity="0.92" Stroke="{ThemeResource AppSubtleBorderBrush}" StrokeThickness="1" />
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74A;" FontSize="16" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Background" BorderBrush="White" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"/>
                            <Border x:Name="BackgroundPointerOver" BorderBrush="White" BorderThickness="0" Background="Transparent" Opacity="0"/>
                            <Border x:Name="BackgroundPressed" BorderBrush="{ThemeResource ThumbBorderBrushPressed}" BorderThickness="0" Background="Transparent" Opacity="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ScheduleRowContainer" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="HomeViewToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/><Setter Target="Label.Opacity" Value="0.65"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Label.Foreground" Value="{ThemeResource AppAccentBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/><Setter Target="Label.Foreground" Value="{ThemeResource AppAccentBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Label.Opacity" Value="0.65"/><Setter Target="Label.Foreground" Value="{ThemeResource AppAccentBrush}"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Label.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Background="{ThemeResource SystemControlBackgroundListLowBrush}" CornerRadius="6" Opacity="0"/>
                        <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Grid>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActiveScheduleContainer" TargetType="ListViewItem" BasedOn="{StaticResource ScheduleRowContainer}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <!-- No rectangular hover/reveal layer behind the translucent rounded card. -->
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch" Padding="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ScheduleRowTemplate" x:DataType="local:CustomData">
            <Border CornerRadius="12" Padding="20,16" material:MaterialSurface.IsEnabled="True"
                    PointerEntered="GridViewStackPanel_PointerEntered"
                    PointerExited="GridViewStackPanel_PointerExited">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Background="{x:Bind MarkerBrush}" CornerRadius="2"/>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Str1}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Str1}"/><FontIcon Grid.Column="1" Glyph="&#xE718;" FontSize="12" Visibility="{x:Bind PinVisibility}"/></Grid>
                        <ProgressBar Value="{x:Bind RangeProgress}" Visibility="{x:Bind RangeVisibility}" Height="4" MaxWidth="240" HorizontalAlignment="Stretch" Foreground="{x:Bind MarkerBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="150" Spacing="6">
                        <TextBlock Text="{x:Bind Str2}" FontSize="18" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource AppAccentBrush}"/>
                        <TextBlock Text="{x:Bind DateText}" FontSize="12" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ScheduleFestivalRowTemplate" x:DataType="local:CustomData">
            <Grid Background="{x:Bind CardBackground}" MinHeight="104"
                  CornerRadius="{ThemeResource AppCardCornerRadius}" Padding="20,16"
                  PointerEntered="GridViewStackPanel_PointerEntered"
                  PointerExited="GridViewStackPanel_PointerExited">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Str1}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{x:Bind CardForeground}"/>
                        <FontIcon Grid.Column="1" Glyph="&#xE718;" FontSize="13" Visibility="{x:Bind PinVisibility}" Foreground="{x:Bind CardForeground}"/>
                    </Grid>
                    <TextBlock Text="{x:Bind Str2}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{x:Bind CardForeground}"/>
                    <ProgressBar Value="{x:Bind RangeProgress}" Visibility="{x:Bind RangeVisibility}" Height="4" Margin="0,8,0,0" Foreground="{x:Bind CardForeground}" Background="#407F7F7F"/>
                    <TextBlock Text="{x:Bind DateText}" FontSize="12" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Foreground="{x:Bind CardForeground}" Opacity="0.85"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ScheduleActiveTemplate" x:DataType="local:CustomData">
            <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}"
                                      PointerEntered="GridViewStackPanel_PointerEntered"
                                      PointerExited="GridViewStackPanel_PointerExited">
            <Border CornerRadius="16" Padding="24" Background="{x:Bind CardBackground}" material:MaterialSurface.SubtleShadow="True">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="8"><TextBlock Text="{x:Bind Str1}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{x:Bind CardForeground}"/></StackPanel>
                        <StackPanel Grid.Column="1" MaxWidth="160"><TextBlock Text="{x:Bind CountdownPrefix}" FontSize="13" TextAlignment="Right" Foreground="{x:Bind CardForeground}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="6"><TextBlock Text="{x:Bind CountdownValue}" FontSize="{x:Bind CountdownFontSize}" FontWeight="Light" TextWrapping="Wrap" TextAlignment="Right" Foreground="{x:Bind CardForeground}"/><TextBlock Text="{x:Bind CountdownUnit}" VerticalAlignment="Bottom" Margin="0,0,0,8" FontSize="14" Foreground="{x:Bind CardForeground}"/></StackPanel></StackPanel>
                    </Grid>
                    <StackPanel Visibility="{x:Bind RangeVisibility}" Spacing="12">
                        <ProgressBar Value="{x:Bind RangeProgress}" Height="6" Foreground="{x:Bind CardForeground}" Background="#55FFFFFF"/>
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind StartLabel}" FontSize="12" TextWrapping="Wrap" Foreground="{x:Bind CardForeground}"/><TextBlock Grid.Column="1" Text="{x:Bind EndLabel}" FontSize="12" TextAlignment="Right" TextWrapping="Wrap" Foreground="{x:Bind CardForeground}"/></Grid>
                        <TextBlock Text="{x:Bind TodayLabel}" FontSize="12" HorizontalAlignment="Center" Foreground="{x:Bind CardForeground}" Opacity="0.9"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind DateText}" FontSize="12" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Foreground="{x:Bind CardForeground}" Opacity="0.9"/>
                </StackPanel>
            </Border>
            </controls:DropShadowPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,16,24,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Today" x:FieldModifier="public" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <Button Grid.Column="1" VerticalAlignment="Center" Click="AppBarButton_Click" Style="{StaticResource AppIconButtonStyle}" BorderThickness="0" Padding="10,6" AutomationProperties.Name="新建日程">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="新建日程" FontSize="14"/></StackPanel>
            </Button>
        </Grid>
        <ScrollViewer x:Name="AllScrollViewer" Grid.Row="1" x:FieldModifier="public" material:CenteredScrollContent.IsEnabled="True" ViewChanged="AllScrollViewer_ViewChanged" ViewChanging="AllScrollViewer_ViewChanging" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AllPageStackPanel" x:FieldModifier="public" MaxWidth="1200" Padding="12,12,12,24">
                <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}" ShadowOpacity="0">
                <Border CornerRadius="12" Padding="20,16"
                        Background="{ThemeResource AppCardBackgroundBrush}"
                        material:MaterialSurface.SubtleShadow="True" material:MaterialSurface.IsEnabled="True">
                    <Grid ColumnSpacing="16" SizeChanged="HomeSummary_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <PersonPicture x:Name="AllPicture" x:FieldModifier="public" Width="48" Height="48" IsTapEnabled="True" Tapped="AllPicture_Tapped" AutomationProperties.Name="编辑个人信息"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock x:Name="UserName" Text="游客" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="UserSign" FontSize="13" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/></StackPanel>
                        <StackPanel x:Name="YearSummary" Grid.Column="2" VerticalAlignment="Center" Width="280" Spacing="10"><TextBlock x:Name="TopText" x:FieldModifier="public" FontSize="13" TextWrapping="Wrap" IsTapEnabled="True" Tapped="TopText_Tapped" ToolTipService.ToolTip="点击切换天数 / 百分比"/><ProgressBar x:Name="MyProgressBar" HorizontalAlignment="Stretch" Height="5" Foreground="{ThemeResource AppAccentBrush}"/></StackPanel>
                    </Grid>
                </Border>
                </controls:DropShadowPanel>
                <TextBlock x:Name="MarginText" x:FieldModifier="public" Height="12"/>
                <CommandBar x:Name="AllCommandBar" x:FieldModifier="public" Background="Transparent" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" OverflowButtonVisibility="Auto">
                    <AppBarButton x:Name="AddABB" Label="新建" Icon="Add" Click="AppBarButton_Click" Visibility="Collapsed"/>
                    <AppBarButton x:Name="ContentChoise" Label="显示全部" Foreground="{ThemeResource AppAccentBrush}"><AppBarButton.Icon><FontIcon Glyph="&#xE71C;"/></AppBarButton.Icon><AppBarButton.Flyout><MenuFlyout>
                        <MenuFlyoutItem x:Name="DisplayAll" Text="显示全部" Click="DisplayAll_Click"/><MenuFlyoutItem Text="进行中 / 今天" Click="DisplayCurrent_Click"/><MenuFlyoutItem x:Name="DisplatPast" Text="显示已过日程" Click="DisplatPast_Click"/><MenuFlyoutItem x:Name="DisplayFuture" Text="显示未过日程" Click="DisplayFuture_Click"/>
                    </MenuFlyout></AppBarButton.Flyout></AppBarButton>
                    <AppBarButton x:Name="ChangeABB" Label="天数模式" Foreground="{ThemeResource AppAccentBrush}"><AppBarButton.Icon><FontIcon Glyph="&#xE163;"/></AppBarButton.Icon><AppBarButton.Flyout><MenuFlyout><MenuFlyoutItem x:Name="DayMode" Text="天数模式" Click="DayMode_Click"/><MenuFlyoutItem x:Name="WeekMode" Text="周数模式" Click="WeekMode_Click"/><MenuFlyoutItem x:Name="YearMode" Text="年数模式" Click="YearMode_Click"/></MenuFlyout></AppBarButton.Flyout></AppBarButton>
                    <AppBarButton x:Name="SortButton" Label="日期排序" Foreground="{ThemeResource AppAccentBrush}"><AppBarButton.Icon><FontIcon Glyph="&#xE8CB;"/></AppBarButton.Icon><AppBarButton.Flyout><MenuFlyout><MenuFlyoutItem Text="日期从近到远" Tag="Date" Click="Sort_Click"/><MenuFlyoutItem Text="名称" Tag="Name" Click="Sort_Click"/></MenuFlyout></AppBarButton.Flyout></AppBarButton>
                </CommandBar>
                <Grid Margin="0,8,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ScheduleCount" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <Grid x:Name="ViewTabs" Grid.Column="1" Loaded="ViewTabs_Loaded" SizeChanged="ViewTabs_SizeChanged">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <ToggleButton x:Name="CardsViewButton" Style="{StaticResource HomeViewToggleStyle}" Content="卡片" Tag="Cards" Click="ViewMode_Click"/>
                            <ToggleButton x:Name="ListViewButton" Style="{StaticResource HomeViewToggleStyle}" Content="列表" Tag="List" Click="ViewMode_Click"/>
                            <ToggleButton x:Name="GroupsViewButton" Style="{StaticResource HomeViewToggleStyle}" Content="分组" Tag="Groups" Click="ViewMode_Click"/>
                        </StackPanel>
                        <Border x:Name="ViewIndicator" Height="2" Width="18" Background="{ThemeResource AppAccentBrush}" CornerRadius="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform x:Name="ViewIndicatorTransform"/></Border.RenderTransform>
                        </Border>
                    </Grid>
                </Grid>
                <ProgressRing x:Name="AllProgressRing" IsActive="False"/>
                <Grid x:Name="ScheduleViewHost" Unloaded="ScheduleViewHost_Unloaded">
                    <Grid.RenderTransform><TranslateTransform x:Name="ScheduleViewTransform"/></Grid.RenderTransform>
                <controls:AdaptiveGridView x:Name="MyGridView" x:FieldModifier="public" ItemsSource="{x:Bind ViewModel.CustomDatas}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MyGirdView_ItemClick" RightTapped="MyGirdView_RightTapped" ContextRequested="Schedule_ContextRequested" animations:ReorderGridAnimation.Duration="450" DesiredWidth="300" ItemHeight="236" StretchContentForSingleRow="False" Margin="-4,0,-4,0">
                    <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,0,4,12"/></Style></GridView.ItemContainerStyle>
                        <GridView.ContextFlyout>
                            <MenuFlyout x:Name="MyMenuFlyout">
                                <MenuFlyoutItem x:Name="SetTop" Icon="Upload" Text="置顶" Visibility="Visible" Click="SetTop_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                <MenuFlyoutItem x:Name="Cancel" Icon="Redo" Text="取消置顶" Visibility="Collapsed" Click="Cancel_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                <MenuFlyoutSeparator x:Name="FS"/>
                                <MenuFlyoutItem x:Name="MyFlyout" Icon="Delete" Text="删除日程" Click="MenuFlyoutItem_Click" IsEnabled="False" Foreground="{ThemeResource AppAccentBrush}"/>
                                <MenuFlyoutSeparator x:Name="FS2"/>
                                <MenuFlyoutItem x:Name="PinToSC" Icon="Pin" Text="固定日程到开始菜单" Visibility="Visible" Click="PinToSC_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                <MenuFlyoutItem x:Name="unPinToSC" Icon="Unpin" Text="从开始菜单中取消固定" Visibility="Collapsed" Click="unPinToSC_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                <MenuFlyoutItem x:Name="MainTile" Icon="Accept" Text="该日程已被自动设为主磁贴&#x0a;将应用固定到开始菜单后自动启用" IsEnabled="False" Visibility="Collapsed" Foreground="{ThemeResource AppAccentBrush}"/>
                            </MenuFlyout>
                        </GridView.ContextFlyout>

                    <GridView.ItemTemplate><DataTemplate x:DataType="local:CustomData">
                        <Grid Background="{x:Bind CardBackground}" CornerRadius="14" Padding="22,18" PointerEntered="GridViewStackPanel_PointerEntered" PointerExited="GridViewStackPanel_PointerExited">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ChildrenTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True"/></TransitionCollection></Grid.ChildrenTransitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Str1}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{x:Bind CardForeground}"/><FontIcon Grid.Column="1" Glyph="&#xE718;" FontSize="13" Margin="8,0,0,0" Visibility="{x:Bind PinVisibility}" Foreground="{x:Bind CardForeground}"/></Grid>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center"><TextBlock Text="{x:Bind CountdownPrefix}" FontSize="13" Foreground="{x:Bind CardForeground}" Opacity="0.85"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Spacing="6"><TextBlock Text="{x:Bind CountdownValue}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Str2}" FontSize="{x:Bind CountdownFontSize}" FontWeight="Light" Foreground="{x:Bind CardForeground}"/><TextBlock Text="{x:Bind CountdownUnit}" VerticalAlignment="Bottom" Margin="0,0,0,10" Foreground="{x:Bind CardForeground}"/></StackPanel></StackPanel>
                            <StackPanel Grid.Row="3" Spacing="10"><TextBlock Text="{x:Bind DateText}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Foreground="{x:Bind CardForeground}" FontSize="12" Opacity="0.85"/><ProgressBar Value="{x:Bind RangeProgress}" Visibility="{x:Bind RangeVisibility}" Height="4" Foreground="{x:Bind CardForeground}" Background="#407F7F7F"/></StackPanel>
                        </Grid>
                    </DataTemplate></GridView.ItemTemplate>

                </controls:AdaptiveGridView>
                <ListView x:Name="ScheduleList" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MyGirdView_ItemClick" RightTapped="ScheduleList_RightTapped" ContextRequested="Schedule_ContextRequested" ItemTemplate="{StaticResource ScheduleFestivalRowTemplate}" ItemContainerStyle="{StaticResource ScheduleRowContainer}"/>
                <StackPanel x:Name="GroupedSchedules" Visibility="Collapsed" Spacing="12">
                    <Button x:Name="CurrentGroupHeader" Click="CurrentGroupHeader_Click" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="40">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentGroupTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                            <FontIcon x:Name="CurrentGroupChevron" Grid.Column="1" Glyph="&#xE70D;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </Grid>
                    </Button>
                    <StackPanel x:Name="CurrentGroupContent" Spacing="12">
                    <controls:AdaptiveGridView x:Name="CurrentSchedules" Padding="12" Margin="-12,0,-12,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MyGirdView_ItemClick" RightTapped="ScheduleList_RightTapped" ContextRequested="Schedule_ContextRequested" ItemTemplate="{StaticResource ScheduleActiveTemplate}" DesiredWidth="520" ItemHeight="250" StretchContentForSingleRow="False">
                        <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/></Style></GridView.ItemContainerStyle>
                    </controls:AdaptiveGridView>
                    <controls:AdaptiveGridView x:Name="CurrentPointSchedules" Padding="0,4,0,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MyGirdView_ItemClick" RightTapped="ScheduleList_RightTapped" ContextRequested="Schedule_ContextRequested" ItemTemplate="{StaticResource ScheduleFestivalRowTemplate}" Loaded="GroupedPoints_Loaded" SizeChanged="GroupedPoints_SizeChanged" DesiredWidth="420" ItemHeight="152" StretchContentForSingleRow="False">
                        <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/></Style></GridView.ItemContainerStyle>
                    </controls:AdaptiveGridView>
                    </StackPanel>
                    <Button x:Name="UpcomingGroupHeader" Click="UpcomingGroupHeader_Click" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="40">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="UpcomingGroupTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                            <FontIcon x:Name="UpcomingGroupChevron" Grid.Column="1" Glyph="&#xE70D;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </Grid>
                    </Button>
                    <StackPanel x:Name="UpcomingGroupContent" Spacing="12">
                    <ListView x:Name="UpcomingSchedules" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MyGirdView_ItemClick" RightTapped="ScheduleList_RightTapped" ContextRequested="Schedule_ContextRequested" ItemTemplate="{StaticResource ScheduleFestivalRowTemplate}" ItemContainerStyle="{StaticResource ScheduleRowContainer}"/>
                    <controls:AdaptiveGridView x:Name="UpcomingPointSchedules" Padding="0,4,0,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MyGirdView_ItemClick" RightTapped="ScheduleList_RightTapped" ContextRequested="Schedule_ContextRequested" ItemTemplate="{StaticResource ScheduleFestivalRowTemplate}" Loaded="GroupedPoints_Loaded" SizeChanged="GroupedPoints_SizeChanged" DesiredWidth="420" ItemHeight="152" StretchContentForSingleRow="False">
                        <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/></Style></GridView.ItemContainerStyle>
                    </controls:AdaptiveGridView>
                    </StackPanel>
                    <Button x:Name="PastGroupHeader" Click="PastGroupHeader_Click" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="40">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="PastGroupTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                            <FontIcon x:Name="PastGroupChevron" Grid.Column="1" Glyph="&#xE70D;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </Grid>
                    </Button>
                    <StackPanel x:Name="PastGroupContent" Spacing="12">
                    <ListView x:Name="PastSchedules" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MyGirdView_ItemClick" RightTapped="ScheduleList_RightTapped" ContextRequested="Schedule_ContextRequested" ItemTemplate="{StaticResource ScheduleFestivalRowTemplate}" ItemContainerStyle="{StaticResource ScheduleRowContainer}"/>
                    <controls:AdaptiveGridView x:Name="PastPointSchedules" Padding="0,4,0,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MyGirdView_ItemClick" RightTapped="ScheduleList_RightTapped" ContextRequested="Schedule_ContextRequested" ItemTemplate="{StaticResource ScheduleFestivalRowTemplate}" Loaded="GroupedPoints_Loaded" SizeChanged="GroupedPoints_SizeChanged" DesiredWidth="420" ItemHeight="152" StretchContentForSingleRow="False">
                        <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,10"/></Style></GridView.ItemContainerStyle>
                    </controls:AdaptiveGridView>
                    </StackPanel>
                </StackPanel>
                </Grid>
                <FontIcon x:Name="EmptyStateIcon" Visibility="Collapsed" Glyph="&#xE787;" FontSize="40" HorizontalAlignment="Center" Margin="0,48,0,12"/>
                <TextBlock x:Name="NewTB" x:FieldModifier="public" Visibility="Collapsed" FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock x:Name="NewTB2" x:FieldModifier="public" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <ContentDialog x:Name="DeleteDialog"
                       Title="确定删除该日程吗?"
                               CornerRadius="8">
                    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="400">
                        <TextBlock TextWrapping="Wrap" Foreground="Gray">
                    删除后该日程将在你的首页中移除，你可以在“新建”页面重新添加。
                        </TextBlock>
                        <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="DeleteDialogPrimaryButton" Content="确认" Click="DeleteDialogPrimaryButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/><Button x:Name="DeleteDialogCloseButton" Content="手滑了" Click="DeleteDialogCloseButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0" Padding="8"/></Grid>
                    </StackPanel>
                </ContentDialog>

            </StackPanel>
        </ScrollViewer>
        <Thumb Margin="50,50,50,80"  Grid.Row="1" Visibility="Collapsed" ToolTipService.ToolTip="返回顶部" Style="{StaticResource ThumbStyle1}" Name="RootThumb" Height="55" Width="55" HorizontalAlignment="Right" VerticalAlignment="Bottom" Canvas.ZIndex="101" Tapped="RootThumb_Tapped">
            <animations:Implicit.ShowAnimations>
                <animations:TranslationAnimation Duration="0:0:1" From="200, 0, 0" To="0" ></animations:TranslationAnimation>
                <animations:OpacityAnimation Duration="0:0:1" From="0" To="1.0"></animations:OpacityAnimation>
            </animations:Implicit.ShowAnimations>

            <animations:Implicit.HideAnimations>
                <animations:ScalarAnimation Target="Opacity" Duration="0:0:1" To="0.0"></animations:ScalarAnimation>
                <animations:ScalarAnimation Target="Translation.X" Duration="0:0:1" To="200">
                </animations:ScalarAnimation>
            </animations:Implicit.HideAnimations>
        </Thumb>

    </Grid>
</Page>

