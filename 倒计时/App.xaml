<Application
    x:Class="倒计时.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:倒计时"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:media="using:Windows.UI.Xaml.Media"
    xmlns:viewModels="using:倒计时.ViewModels" xmlns:winui="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <winui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <!-- Shared Fluent 2 visual tokens used by pages and dialogs. -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="CornflowerBlue" />
            <SolidColorBrush x:Key="AppSubtleBorderBrush" Color="{ThemeResource SystemBaseLowColor}" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{ThemeResource SystemChromeAltHighColor}" />
            <!-- App registers control-state accent brushes before creating any pages. -->
            <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
            <Thickness x:Key="AppControlBorderThickness">1</Thickness>
            <CornerRadius x:Key="AppControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="AppCardCornerRadius">16</CornerRadius>
            <FontFamily x:Key="AppIconFontFamily">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
            <ControlTemplate x:Key="AppButtonTemplate" TargetType="Button">
                <Grid x:Name="ButtonRoot" Background="Transparent">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverLayer.Opacity" Value="1"/></VisualState.Setters></VisualState>
                            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="ButtonRoot.Opacity" Value="0.72"/><Setter Target="HoverLayer.Opacity" Value="1"/></VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ButtonRoot.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
                    <Border x:Name="HoverLayer" Background="{ThemeResource SystemControlBackgroundListLowBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False"/>
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </ControlTemplate>
            <Style x:Key="AppPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Template" Value="{StaticResource AppButtonTemplate}"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="CornerRadius" Value="{ThemeResource AppControlCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style x:Key="AppSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Template" Value="{StaticResource AppButtonTemplate}"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="CornerRadius" Value="{ThemeResource AppControlCornerRadius}" />
                <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
            </Style>
            <Style x:Key="AppIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Template" Value="{StaticResource AppButtonTemplate}"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="{ThemeResource AppControlCornerRadius}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource AppAccentBrush}" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource AppSecondaryButtonStyle}"/>
            <Style x:Key="AppPageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="AppBodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </Style>
            <Style x:Key="AppCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" />
            </Style>
            <Style x:Key="AppSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
            </Style>
            <Style x:Key="AppCardShadowStyle" TargetType="controls:DropShadowPanel">
                <Setter Property="BlurRadius" Value="16" />
                <Setter Property="ShadowOpacity" Value="0.16" />
                <Setter Property="OffsetX" Value="0" />
                <Setter Property="OffsetY" Value="4" />
                <Setter Property="Color" Value="Black" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="IsMasked" Value="True" />
            </Style>
            <Style x:Key="AppCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{ThemeResource AppCardCornerRadius}" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="PrimaryButtonStyle" Value="{StaticResource AppPrimaryButtonStyle}" />
                <Setter Property="SecondaryButtonStyle" Value="{StaticResource AppSecondaryButtonStyle}" />
                <Setter Property="CloseButtonStyle" Value="{StaticResource AppSecondaryButtonStyle}" />
            </Style>

            <viewModels:ViewModelLocator x:Name="Locator" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="AppCardAcrylicBrush" BackgroundSource="Backdrop"
                                  TintColor="#FFFFFF" TintOpacity="0.85" FallbackColor="#FFFFFF"/>

                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppSubtleBorderBrush" Color="#19000000"/>
                    <!--<Color x:Key="NavigationViewBackgroundColor">#F9FAFE</Color>-->
                    <media:AcrylicBrush x:Key="CustomAcrylicBackgroundBrush" BackgroundSource="HostBackdrop"
TintOpacity="0.7" TintColor="White" FallbackColor="White"/>
                    <AcrylicBrush x:Key="CustomAcrylicInAppBrush" BackgroundSource="HostBackdrop"
TintOpacity="0.5" TintColor="White" FallbackColor="White" />
                    <AcrylicBrush x:Key="CustomAcrylicInAppBrush1" BackgroundSource="HostBackdrop"
TintOpacity="0.95"  TintColor="White" FallbackColor="White" />
                    <media:AcrylicBrush x:Key="CustomAcrylicBackgroundBrush2" BackgroundSource="HostBackdrop"
TintOpacity="0.7" TintColor="AliceBlue" FallbackColor="White" />
                    <media:AcrylicBrush x:Key="CustomAcrylicBackgroundBrush3" BackgroundSource="Backdrop"
TintOpacity="0.7" TintColor="AliceBlue" FallbackColor="White" />
                    <SolidColorBrush x:Key="GlobalTheme" x:FieldModifier="public"/>
                    <FontFamily x:Key="CalculatorFontFamily">ms-appx:///Assets/CalcMDL2.ttf#Calculator MDL2 Assets</FontFamily>
                    <AcrylicBrush x:Key="ModuleBackground" BackgroundSource="HostBackdrop" TintColor="{ThemeResource SystemChromeMediumColor}" TintOpacity="0.5"/>

                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="AppCardAcrylicBrush" BackgroundSource="Backdrop"
                                  TintColor="#2B2B2B" TintOpacity="0.85" FallbackColor="#2B2B2B"/>

                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#2B2B2B"/>
                    <SolidColorBrush x:Key="AppSubtleBorderBrush" Color="#33FFFFFF"/>
                    <!--<Color x:Key="NavigationViewBackgroundColor">#F9FAFE</Color>-->
                    <media:AcrylicBrush x:Key="CustomAcrylicBackgroundBrush" BackgroundSource="HostBackdrop"
TintOpacity="0.7" TintColor="White" FallbackColor="White"/>
                    <AcrylicBrush x:Key="CustomAcrylicInAppBrush" BackgroundSource="HostBackdrop"
TintOpacity="0.5" TintColor="White" FallbackColor="White" />
                    <AcrylicBrush x:Key="CustomAcrylicInAppBrush1" BackgroundSource="HostBackdrop"
TintOpacity="0.95"  TintColor="White" FallbackColor="White" />
                    <media:AcrylicBrush x:Key="CustomAcrylicBackgroundBrush2" BackgroundSource="HostBackdrop"
TintOpacity="0.7" TintColor="AliceBlue" FallbackColor="White" />
                    <media:AcrylicBrush x:Key="CustomAcrylicBackgroundBrush3" BackgroundSource="Backdrop"
TintOpacity="0.7" TintColor="AliceBlue" FallbackColor="White" />
                    <SolidColorBrush x:Key="GlobalTheme" x:FieldModifier="public"/>
                    <FontFamily x:Key="CalculatorFontFamily">ms-appx:///Assets/CalcMDL2.ttf#Calculator MDL2 Assets</FontFamily>
                    <AcrylicBrush x:Key="ModuleBackground" BackgroundSource="HostBackdrop" TintColor="{ThemeResource SystemChromeMediumColor}" TintOpacity="0.5"/>

                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppCardAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}"/>

                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="AppSubtleBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>
