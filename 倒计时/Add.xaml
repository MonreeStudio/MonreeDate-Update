<Page
    x:Class="倒计时.Add"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:倒计时"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:control="using:倒计时.Controls"
    mc:Ignorable="d"
    Margin="0"
>

    <Page.Resources>
        <SolidColorBrush x:FieldModifier="public" x:Name="TC" x:Key="ThemeColor"  Color="CornflowerBlue"/>
        <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="ThemeColor" />
        <StaticResource x:Key="SliderThumbBackground" ResourceKey="ThemeColor" />



    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button x:Name="RefreshBtn" Grid.Row="0" Content="❔ 无法选择日期？点我！"
                HorizontalAlignment="Right" Margin="0,8,24,2"
                Click="RefreshBtn_Click"
                Style="{StaticResource AppSecondaryButtonStyle}"
                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                Foreground="{ThemeResource AppAccentBrush}"
                FontSize="13" Padding="8,4" MinWidth="0" MinHeight="32"
                CornerRadius="6"/>
        <ScrollViewer Grid.Row="1" SizeChanged="ScheduleScrollViewer_SizeChanged"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center">
        <Grid x:Name="ScheduleCard" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center"
              Margin="12,16,12,32" Padding="24,28,24,32"
              Background="Transparent">
        <Grid x:Name="AddPageGird" x:FieldModifier="Public"
              HorizontalAlignment="Stretch" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="创建一个日程吧！"
                   x:Name="TipTB"
                   Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,0,0,28"
                   FontSize="36"
                   FontFamily="FZShuti"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{x:Bind TC}" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Margin="0,0,0,20">
            <TextBlock Text="日程名称" Margin="0,0,0,8" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBox x:Name="AddEvent"
                 PlaceholderText="例如：项目上线、朋友生日"
                 Grid.Row="1"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 CornerRadius="8"
                 BorderBrush="{x:Bind TC}"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 Height="44" MinHeight="44"
                 Padding="12,10"
                 BorderThickness="1"/>
                <ComboBox x:Name="ScheduleTypePicker" Header="日程类型" SelectedIndex="0" Margin="0,16,0,0"
                          HorizontalAlignment="Stretch" CornerRadius="8" BorderBrush="{x:Bind TC}"
                          SelectionChanged="ScheduleTypePicker_SelectionChanged">
                    <ComboBoxItem Content="单日"/>
                    <ComboBoxItem Content="日期范围"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                <TextBlock x:Name="StartDateLabel" Text="日程日期" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                <Grid HorizontalAlignment="Left" MaxWidth="290">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                <CalendarDatePicker
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Margin="0"
                            x:Name="Add_Picker"
                            BorderThickness="1"
                                    IsGroupLabelVisible="True"
                            Foreground="{x:Bind TC}"
                            BorderBrush="{x:Bind TC}"
                            DateFormat="{}{year.full}/{month.integer}/{day.integer}"
                            CornerRadius="8"
                            MinWidth="0" MaxWidth="220"
                            PlaceholderText="选择一个日期"
                            DateChanged="Add_Picker_DateChanged"
                            >
                    <CalendarDatePicker.CalendarViewStyle>
                        <Style TargetType="CalendarView" BasedOn="{StaticResource CalendarViewRevealStyle}">
                            <Setter Property="CalendarViewDayItemStyle">
                                <Setter.Value>
                                    <Style TargetType="CalendarViewDayItem">
                                        <Setter Property="Padding" Value="0, 0, 0, 18" />
                                        <Setter Property="MinWidth" Value="44" />
                                        <Setter Property="MinHeight" Value="48" />
                                        <Setter Property="Margin" Value="1" />
                                        <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                                        <Setter Property="FocusVisualMargin" Value="-2" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="CalendarViewDayItem">
                                                    <!-- For CalendarViewDayItem, TextBlock visual is created and handled by code and we can't see it from the style. -->
                                                    <!-- CCalendarViewBaseItemChrome creates and appends a TextBlock in the visual after the ControlTemplate is applied -->
                                                    <!-- VSM needs a container and that's why Grid is added. But we don't need the rendering of Grid so We set width to 0 -->
                                                    <Grid x:Name="Root">

                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal" />

                                                                <VisualState x:Name="PointerOver">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="Root.(RevealBrush.State)" Value="PointerOver" />
                                                                    </VisualState.Setters>
                                                                </VisualState>

                                                                <VisualState x:Name="Pressed">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="Root.(RevealBrush.State)" Value="Pressed" />
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                            </VisualStateGroup>

                                                        </VisualStateManager.VisualStateGroups>
                                                        <control:CalendarViewDayLunarItem Date="{TemplateBinding Date}" Foreground="DarkGray" Margin="0,0,0,-14" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CalendarDatePicker.CalendarViewStyle>
                </CalendarDatePicker>
                <TextBlock Grid.Column="1" Text="或" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <Button Grid.Column="2" x:Name="DateChooseBtn" Content="&#x1F4A1;" ToolTipService.ToolTip="试一试选择多少天后的日子" FontSize="18" FontFamily="Segoe UI Emoji" Margin="0" Click="DateChooseBtn_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="100"/>
                </Grid>
                <StackPanel x:Name="EndDatePanel" Visibility="Collapsed" Margin="0,16,0,12">
                    <TextBlock Text="结束日期" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <Grid HorizontalAlignment="Left" MaxWidth="220">
                    <CalendarDatePicker x:Name="End_Picker" HorizontalAlignment="Stretch" BorderThickness="1"
                                        Foreground="{x:Bind TC}" BorderBrush="{x:Bind TC}" CornerRadius="8"
                                        DateFormat="{}{year.full}/{month.integer}/{day.integer}" MinWidth="0" MaxWidth="220"
                                        IsGroupLabelVisible="True" PlaceholderText="选择结束日期" DateChanged="Add_Picker_DateChanged"/>
                    </Grid>
                    <TextBlock Text="包含开始和结束当天；提醒以开始日期为准。" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock x:Name="DateValidationText" Visibility="Collapsed" Foreground="Crimson" Margin="0,0,0,8" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="3" Grid.ColumnSpan="2" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Button Content="背景选项"
                        x:Name="BgsButton"
                        Grid.Column="1"
                        Width="140"
                        HorizontalAlignment="Center"
                        Padding="16,8" MinHeight="40"
                        Click="BgsButton_Click" Style="{StaticResource AppSecondaryButtonStyle}"/>
                <Ellipse x:Name="MyEllipse" Grid.Column="2" Height="20" Width="20" HorizontalAlignment="Left" Margin="10,0,0,0" Fill="Transparent" StrokeThickness="0"/>
            </Grid>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,20">
                <Button x:Name="TipButton"
                Content="添加备注"
                Grid.Row="4"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                Width="140"
                Padding="16,8" MinHeight="40"
                Click="TipButton_Click" Style="{StaticResource AppSecondaryButtonStyle}"/>
                <TextBlock x:Name="TTB" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="14" MaxWidth="440" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Stretch" TextAlignment="Center"/>
            </StackPanel>
            <Button Content="确认添加"
                x:Name="AddButton"
                Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                Width="140"
                Click="Button_Click" Style="{StaticResource AppPrimaryButtonStyle}"/>

            <ContentDialog x:Name="BgsDialog"
                   Title="背景设置"
                   CornerRadius="{ThemeResource AppControlCornerRadius}"
                   >
                <ScrollViewer Padding="10,0,10,0">
                    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <TextBlock Text="建议选择较为温和的颜色" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="5,0,0,0" TextWrapping="Wrap"/>
                            <ColorPicker x:Name="MyColorPicker"
                             Margin="5"
                             IsColorSliderVisible="True"
                             IsMoreButtonVisible="True"
                             IsColorChannelTextInputVisible="True"
                             IsHexInputVisible="True"
                             IsAlphaEnabled="False"
                             IsAlphaSliderVisible="True"
                             IsAlphaTextInputVisible="True"
                             />
                        <Button Content="选择自带颜色" Style="{StaticResource AppSecondaryButtonStyle}">
                        <Button.Flyout>
                            <Flyout x:Name="DefaltColorFlyout">
                                    <StackPanel Orientation="Vertical" Width="240">
                                        <TextBlock Text="自带颜色" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,2" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                        <GridView x:Name="ColorGridView" ItemsSource="{x:Bind ViewModel.ThemeColorDatas}" IsItemClickEnabled="True" ItemClick="ColorGridView_ItemClick">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="local:ThemeColorData">
                                                    <StackPanel>
                                                        <Rectangle Fill="{x:Bind themeColor}" Height="40" Width="40" ToolTipService.ToolTip="{x:Bind colorName}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                        <TextBlock Text="Tip：如果您有不错的配色方案，欢迎邮箱联系我~" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Slider AutomationProperties.Name="Slider with ticks"
                        x:Name="MySlider"
                            Foreground="{x:Bind TC}"
                        Header="不透明度（推荐40~80，0为全透明）"
                        Margin="5"
                        Value="80"
                        Maximum="100"
                        TickFrequency="10"
                        TickPlacement="Outside" />

                        <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="BgsDialogPrimaryButton" Content="确认" Click="BgsDialogPrimaryButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/><Button x:Name="BgsDialogCloseButton" Content="取消" Click="BgsDialogCloseButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0" Padding="8"/></Grid>
                    </StackPanel>

    </ScrollViewer>
    </ContentDialog>
            <ContentDialog x:Name="TipDialog"
                       Title="添加备注"
                       CornerRadius="{ThemeResource AppControlCornerRadius}"
                       >
                <StackPanel>
                    <TextBox x:Name="TipTextbox" Margin="5" TextWrapping="Wrap" BorderThickness="2" PlaceholderText ="备注可留空" CornerRadius="8"/>
                    <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="TipDialogPrimaryButton" Content="确认" Click="TipDialogPrimaryButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/><Button x:Name="TipDialogCloseButton" Content="取消" Click="TipDialogCloseButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0" Padding="8"/></Grid>
                </StackPanel>

            </ContentDialog>
            <ContentDialog x:Name="DateDialog"
                       Title="选择多少天后的日子"
                       CornerRadius="{ThemeResource AppControlCornerRadius}"
                           Foreground="{x:Bind TC}"
                       >
                <StackPanel>
                    <TextBlock x:Name="TodayDate" Text="今天是……" Foreground="DimGray" FontSize="16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBox x:Name="DaysTextBox" MaxLength="5" InputScope="Number" Margin="0,0,5,0" CornerRadius="5" FontSize="15" TextAlignment="Center" BorderBrush="{x:Bind TC}" TextChanged="DaysTextBox_TextChanged"/>
                        <TextBlock x:Name="DayCountTextBlock" Text="天后" VerticalAlignment="Center" Width="Auto" FontSize="20" Foreground="SlateGray"/>
                    </StackPanel>
                    <Grid Margin="0,24,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="DateDialogPrimaryButton" Content="确认" Click="DateDialogPrimaryButton_Click" Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0" Padding="8"/><Button x:Name="DateDialogCloseButton" Content="取消" Click="DateDialogCloseButton_Click" Style="{StaticResource AppSecondaryButtonStyle}" MinWidth="0" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0" Padding="8"/></Grid>
                </StackPanel>
            </ContentDialog>
        </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
