        <!-- Clean plan-row chrome: no gray fill, soft rounded hover only. -->
        <Style x:Key="PlanListRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverBorder.Opacity" Value="0.72" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Rectangle x:Name="HoverBorder" IsHitTestVisible="False" Opacity="0"
                                       Fill="{ThemeResource SystemControlBackgroundListLowBrush}" RadiusX="10" RadiusY="10" />
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ToDoTopText"
                       Text="计划"
                       Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Top" Style="{StaticResource AppPageTitleStyle}" Margin="24,24,24,16" Grid.ColumnSpan="2"/>

        <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" layout:CenteredScrollContent.IsEnabled="True">
            <StackPanel x:Name="PlanContent" Margin="24,16,24,24" MaxWidth="880" Spacing="24">
                <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}">
                    <StackPanel CornerRadius="{ThemeResource AppCardCornerRadius}" Padding="20" material:MaterialSurface.IsEnabled="True" BorderThickness="0">
                    <TextBlock Text="未完成" FontWeight="Bold" FontSize="22" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <Border x:Name="ListCard1" CornerRadius="12" Margin="0,20,0,0"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                Background="Transparent"
                                Padding="2">
                        <ListView x:Name="ToDoList1" Padding="0" Height="Auto" ItemsSource="{x:Bind ToDoTaskViewModel1.ToDoDatas}" IsItemClickEnabled="True" SelectionMode="None" IsMultiSelectCheckBoxEnabled="False" SelectionChanged="ToDoList_SelectionChanged" RightTapped="ToDoList1_RightTapped" Background="Transparent" ItemClick="ToDoList_ItemClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource PlanListRowStyle}"/>
                            </ListView.ItemContainerStyle>
                            <ListView.ContextFlyout>
                                <MenuFlyout >
                                    <MenuFlyoutItem x:Name="StarButton1" Icon="SolidStar" Text="设为重要" Click="StarButton1_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                    <MenuFlyoutItem x:Name="UnStarButton1" Icon="UnFavorite" Text="设为非重要" Click="UnStarButton1_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                    <MenuFlyoutItem x:Name="DeleteButton1" Icon="Delete" Text="删除计划" Foreground="Red" Click="DeleteButton1_Click"/>
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local1:ToDoTasks">
                                    <Grid MinHeight="64" Background="Transparent">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button x:Name="UnDoneButton" Margin="10" Tag="{x:Bind TaskId}" Content="&#xEA3A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="40" Height="40" Click="UnDoneButton_Click" Style="{StaticResource AppIconButtonStyle}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,8,12,8">
                                            <TextBlock x:Name="UnDoneTaskNameTextBlock"   Text="{x:Bind Name}" TextWrapping="Wrap" FontSize="16" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{x:Bind StarVisibility}" Margin="0,0,15,0">
                                                    <FontIcon Glyph="&#xE113;"  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                    <TextBlock Margin="2,0,0,0" Text="重要" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{x:Bind DateVisibility}" Margin="0,0,15,0">
                                                    <FontIcon Glyph="&#xE163;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                    <TextBlock Margin="2,0,0,0" Text="{x:Bind Date}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{x:Bind RemarkVisibility}">
                                                    <FontIcon Glyph="&#xE70B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                    <TextBlock Margin="2,0,0,0" Text="备注" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Margin="60,0,24,0" Background="{ThemeResource AppSubtleBorderBrush}" Visibility="{x:Bind SeparatorVisibility}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
                </controls:DropShadowPanel>

                <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}">
                    <StackPanel CornerRadius="{ThemeResource AppCardCornerRadius}" Padding="20"  material:MaterialSurface.IsEnabled="True" BorderThickness="0">
                    <TextBlock Text="已完成" FontWeight="Bold" FontSize="22" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    <Border x:Name="ListCard2" CornerRadius="12" Margin="0,20,0,0"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                Background="Transparent"
                                Padding="2">
                        <ListView x:Name="ToDoList2" Padding="0" Height="Auto" ItemsSource="{x:Bind ToDoTaskViewModel2.ToDoDatas}" IsItemClickEnabled="True" SelectionMode="None" IsMultiSelectCheckBoxEnabled="False" SelectionChanged="ToDoList2_SelectionChanged"  RightTapped="ToDoList2_RightTapped"  Background="Transparent" ItemClick="ToDoList_ItemClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource PlanListRowStyle}"/>
                            </ListView.ItemContainerStyle>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="StarButton2" Icon="SolidStar" Text="设为重要" Click="StarButton1_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                    <MenuFlyoutItem x:Name="UnStarButton2" Icon="UnFavorite"  Text="设为非重要" Visibility="Collapsed" Click="UnStarButton1_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                    <MenuFlyoutItem x:Name="DeleteButton2" Icon="Delete" Text="删除计划" Foreground="Red" Click="DeleteButton2_Click"/>
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local1:ToDoTasks">
                                    <Grid MinHeight="64" Background="Transparent">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button x:Name="DoneButton" Margin="10" Tag="{x:Bind TaskId}" Content="&#xE10B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="40" Height="40" Click="DoneButton_Click" Style="{StaticResource AppIconButtonStyle}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,8,12,8">
                                            <TextBlock x:Name="DoneTaskNameTextBlock"   Text="{x:Bind Name}" TextWrapping="Wrap" FontSize="16" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{x:Bind StarVisibility}" Margin="0,0,15,0">
                                                    <FontIcon Glyph="&#xE113;"  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                                    <TextBlock Margin="2,0,0,0" Text="重要" Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{x:Bind DateVisibility}" Margin="0,0,15,0">
                                                    <FontIcon Glyph="&#xE163;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                                    <TextBlock Margin="2,0,0,0" Text="{x:Bind Date}" Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{x:Bind RemarkVisibility}">
                                                    <FontIcon Glyph="&#xE70B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                                    <TextBlock Margin="2,0,0,0" Text="备注" Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Margin="60,0,24,0" Background="{ThemeResource AppSubtleBorderBrush}" Visibility="{x:Bind SeparatorVisibility}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
                </controls:DropShadowPanel>

            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <m_control:CardView material:FloatingPlanCard.IsEnabled="True" x:Name="TaskCard" Header="编辑计划" Radius="12" Foreground="{ThemeResource AppAccentBrush}" Margin="20" VerticalAlignment="Center" Padding="8" MaxWidth="500" IsOpen="False" Background="{ThemeResource AppCardBackgroundBrush}" LightDismissLayerBackground="Transparent" material:MaterialSurface.IsOverlay="True" material:MaterialSurface.IsEnabled="True">
                <ScrollViewer>
                    <StackPanel Orientation="Vertical" Margin="20">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddStepButton" FontSize="10" VerticalAlignment="Center" Content="&#xE109;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="36" Height="36" Margin="10" Click="AddStepButton_Click" Style="{StaticResource AppIconButtonStyle}"/>
                            <controls:DropShadowPanel Grid.Column="1" Style="{StaticResource AppCardShadowStyle}" Margin="10,0,10,0" ShadowOpacity="0.07" BlurRadius="14" OffsetY="3">
                                <Border CornerRadius="8" Background="{ThemeResource AppCardBackgroundBrush}">
                                <TextBox x:Name="StepNameTextBox" BorderThickness="0" Background="Transparent" Padding="15" FontSize="14" CornerRadius="8" PlaceholderText="添加具体内容"/>
                                </Border>
                                </controls:DropShadowPanel>
                        </Grid>
                        <ListView x:Name="TaskStepList" Height="Auto" ItemsSource="{x:Bind ToDoTaskStepsViewModel.ToDoTaskStepsDatas}" IsItemClickEnabled="True" SelectionMode="None" IsMultiSelectCheckBoxEnabled="False"  Background="Transparent" ItemClick="TaskStepList_ItemClick" RightTapped="TaskStepList_RightTapped">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource PlanListRowStyle}"/>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local1:ToDoTaskSteps">
                                    <Grid  Background="Transparent" CornerRadius="8" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon x:Name="DoneIcon"  Margin="5,10,0,10" Grid.Column="0" Glyph="&#xE10B;" Visibility="{x:Bind Finish}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                        <FontIcon x:Name="UnDoneIcon"  Margin="5,10,0,10" Grid.Column="0" Glyph="&#xEA3A;" Visibility="{x:Bind UnFinish}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                        <TextBlock x:Name="SetpContentTextBlock" Text="{x:Bind Content}" Padding="10" Grid.Column="1" Height="40" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="EditSetpButton" Icon="Edit" Text="更改名称" Click="EditSetpButton_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                    <MenuFlyoutItem x:Name="DoneStepButton" Icon="Accept"  Text="设为已完成" Click="DoneStepButton_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                    <MenuFlyoutItem x:Name="UnDoneStepButton" Icon="ReDo"  Text="设为未完成" Visibility="Collapsed" Click="UnDoneStepButton_Click" Foreground="{ThemeResource AppAccentBrush}"/>
                                    <MenuFlyoutItem x:Name="DeleteStepButton" Icon="Delete" Text="删除该条内容" Foreground="Red" Click="DeleteStepButton_Click"/>
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>
                        <StackPanel HorizontalAlignment="Left" Spacing="4">
                            <TextBlock Text="过期时间" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}" ShadowOpacity="0.07" BlurRadius="14" OffsetY="3">
                            <Border CornerRadius="8" Background="{ThemeResource AppCardBackgroundBrush}" Padding="2">
                            <CalendarDatePicker
                                        x:Name="ToDo_Picker"
                                        Header=""
                                        BorderThickness="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        DateFormat="{}{year.full}/{month.integer}/{day.integer}"
                                        CornerRadius="8"
                                        PlaceholderText="选择一个日期"
                                        IsGroupLabelVisible="False"/>
                            </Border>
                            </controls:DropShadowPanel>
                            </StackPanel>
                        <StackPanel Margin="0,10,0,0" Spacing="4">
                            <TextBlock Text="备注：" FontSize="12" Foreground="{x:Bind TC}"/>
                            <controls:DropShadowPanel Style="{StaticResource AppCardShadowStyle}" ShadowOpacity="0.07" BlurRadius="14" OffsetY="3">
                            <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}">
                            <TextBox x:Name="ToDoRemarkTextBox" Foreground="{x:Bind TC}" Text="明天" FontSize="14" IsColorFontEnabled="True" CornerRadius="12" BorderThickness="0" Background="Transparent"/>
                            </Border>
                            </controls:DropShadowPanel>
                            </StackPanel>
                        <Button x:Name="UpdateTastButton" Content="更新时间和备注" Margin="0,30,0,0" Click="UpdateTastButton_Click" Style="{StaticResource AppPrimaryButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>

            </m_control:CardView>
        </Grid>
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Height="100" HorizontalAlignment="Center" Width="{Binding Width, ElementName=PlanContent}">
            <Grid Margin="0,10,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AddTaskButton" VerticalAlignment="Center" Content="&#xE109;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="50" Height="50" Margin="10" Click="AddTaskButton_Click" Style="{StaticResource AppIconButtonStyle}"/>
                <controls:DropShadowPanel Grid.Column="1" Style="{StaticResource AppCardShadowStyle}" Margin="10,8,10,8" ShadowOpacity="0.06" BlurRadius="10" OffsetY="2">
                    <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}">
                    <TextBox x:Name="TaskNameTextBox" BorderThickness="0" Background="Transparent" Padding="14,10" Height="50" FontSize="22" CornerRadius="12" PlaceholderText="添加计划" FocusVisualMargin="-2"> <TextBox.Resources> <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource SystemChromeAltHighColor}"/> <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource SystemChromeAltHighColor}"/> <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/> <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/> <SolidColorBrush x:Key="TextControlBorderBrushFocusedPointerOver" Color="Transparent"/> <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#6688AAEE"/> </TextBox.Resources> </TextBox>
                    </Border>
                </controls:DropShadowPanel>
            </Grid>
        </Grid>
        <ContentDialog x:Name="DeleteTaskDialog"
                       Title="确定删除该计划吗?"
                       PrimaryButtonText="确定"
                       CloseButtonText="手滑了"
                               CornerRadius="8"
                       DefaultButton="Primary"

                       PrimaryButtonClick="DeleteTaskDialog_PrimaryButtonClick">
            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="400">
                <TextBlock TextWrapping="Wrap" Foreground="DarkSlateGray">
                    该计划将被永久删除，请确认后操作
                </TextBlock>
            </StackPanel>
        </ContentDialog>
        <ContentDialog x:Name="UpdateTaskStepDialog"
                       Title="修改该条内容名称"
                       PrimaryButtonText="确定"
                       CloseButtonText="取消"
                               CornerRadius="8"
                       DefaultButton="Primary"
                       PrimaryButtonClick="UpdateTaskStepDialog_PrimaryButtonClick">
            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="400">
                <TextBox x:Name="DialogStepNameTextBox" TextWrapping="Wrap" Margin="5,10,5,0" BorderThickness="1" CornerRadius="12"/>
            </StackPanel>
        </ContentDialog>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger
                        MinWindowWidth="{x:Bind MinMyNav}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ToDoTopText.Margin" Value="24,24,24,16"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1080" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ToDoTopText.Margin" Value="24,24,24,16"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ToDoTopText.Margin" Value="24,24,24,16"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    </Grid>
</Page>
